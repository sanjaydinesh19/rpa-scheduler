<Activity mc:Ignorable="sap sap2010" x:Class="Main"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
 xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:jl="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_BaseUrl" Type="InArgument(x:String)" />
    <x:Property Name="in_ApiKey" Type="InArgument(s:Security.SecureString)" />
    <x:Property Name="in_MaxTransactions" Type="InArgument(x:Int32)" />
    <x:Property Name="in_MaxRetryAttempts" Type="InArgument(x:Int32)" />
    <x:Property Name="in_DryRunNotifications" Type="InArgument(x:Boolean)" />
    <x:Property Name="in_ExcelPath" Type="InArgument(x:String)" />
    <x:Property Name="in_HospitalName" Type="InArgument(x:String)" />
    <x:Property Name="in_TwilioSid" Type="InArgument(x:String)" />
    <x:Property Name="in_TwilioAuth" Type="InArgument(s:Security.SecureString)" />
    <x:Property Name="in_TwilioFrom" Type="InArgument(x:String)" />
    <x:Property Name="in_SendGridKey" Type="InArgument(s:Security.SecureString)" />
    <x:Property Name="in_SendGridFrom" Type="InArgument(x:String)" />
    <x:Property Name="out_Processed" Type="OutArgument(x:Int32)" />
    <x:Property Name="out_Failed" Type="OutArgument(x:Int32)" />
  </x:Members>
  <sap2010:ExpressionActivityEditor.ExpressionActivityEditor>VisualBasic</sap2010:ExpressionActivityEditor.ExpressionActivityEditor>
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="8">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Text.RegularExpressions</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>Newtonsoft.Json.Linq</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference" Capacity="8">
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Text.RegularExpressions</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Web.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
      <AssemblyReference>Newtonsoft.Json</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>

  <Sequence DisplayName="Scheduling Bot" sap2010:WorkflowViewState.IdRef="Seq_Root">
    <sap2010:Annotation.AnnotationText>SCHEDULING BOT — REST-driven flow.

Pulls PENDING_PUSH BookingRequests from the Mock HMS, allocates the best slot,
locks + books + releases, mirrors to Excel, sends confirmation, marks the
request PROCESSED. Uses shared/HMS_Client.xaml for every HMS call so auth,
retry and error envelope handling live in one place.

The Orchestrator Queue Trigger (queue: BookingRequests) can call this same
process; simply swap the "poll PENDING_PUSH" call for Get Transaction Item and
translate SpecificContent into the CurrentReq JObject.</sap2010:Annotation.AnnotationText>
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="StatusCode" />
      <Variable x:TypeArguments="x:String" Name="ResponseJson" />
      <Variable x:TypeArguments="x:String" Name="ErrorCode" />
      <Variable x:TypeArguments="x:Boolean" Name="Retryable" />
      <Variable x:TypeArguments="jl:JArray" Name="Pending" />
      <Variable x:TypeArguments="x:Int32" Name="Idx" Default="[0]" />
      <Variable x:TypeArguments="jl:JObject" Name="CurrentReq" />
      <Variable x:TypeArguments="x:String" Name="RequestRef" />
      <Variable x:TypeArguments="x:String" Name="Phone" />
      <Variable x:TypeArguments="x:String" Name="Email" />
      <Variable x:TypeArguments="x:String" Name="PatientName" />
      <Variable x:TypeArguments="x:String" Name="Department" />
      <Variable x:TypeArguments="x:String" Name="Urgency" />
      <Variable x:TypeArguments="x:String" Name="TimeBand" />
      <Variable x:TypeArguments="x:String" Name="DateFrom" />
      <Variable x:TypeArguments="x:String" Name="DateTo" />
      <Variable x:TypeArguments="x:Boolean" Name="IsFollowUp" />
      <Variable x:TypeArguments="x:String" Name="Reason" />
      <Variable x:TypeArguments="x:Int32" Name="PreferredDoctorId" />
      <Variable x:TypeArguments="x:Int32" Name="PatientId" />
      <Variable x:TypeArguments="x:Int32" Name="PatientAge" />
      <Variable x:TypeArguments="x:String" Name="PatientChannel" />
      <Variable x:TypeArguments="x:Boolean" Name="SmsConsent" />
      <Variable x:TypeArguments="x:Boolean" Name="EmailConsent" />
      <Variable x:TypeArguments="x:String" Name="Priority" />
      <Variable x:TypeArguments="jl:JArray" Name="Slots" />
      <Variable x:TypeArguments="jl:JObject" Name="SelectedSlot" />
      <Variable x:TypeArguments="x:Int32" Name="SelectedSlotId" />
      <Variable x:TypeArguments="x:Int32" Name="SelectedSlotVersion" />
      <Variable x:TypeArguments="x:Int32" Name="AllocationPass" />
      <Variable x:TypeArguments="scg:List(x:Int32)" Name="ExcludedSlots" />
      <Variable x:TypeArguments="x:Int32" Name="AttemptsUsed" Default="[0]" />
      <Variable x:TypeArguments="x:Boolean" Name="Booked" Default="[False]" />
      <Variable x:TypeArguments="x:Int32" Name="AppointmentId" />
      <Variable x:TypeArguments="x:String" Name="AppointmentRef" />
      <Variable x:TypeArguments="x:String" Name="AppointmentDateTime" />
      <Variable x:TypeArguments="x:String" Name="DoctorName" />
      <Variable x:TypeArguments="x:String" Name="NotificationChannel" />
      <Variable x:TypeArguments="x:Boolean" Name="NotifOk" />
      <Variable x:TypeArguments="x:String" Name="NotifMessageId" />
      <Variable x:TypeArguments="x:String" Name="NotifError" />
      <Variable x:TypeArguments="x:Boolean" Name="NotifRetryable" />
      <Variable x:TypeArguments="x:String" Name="MsgBody" />
      <Variable x:TypeArguments="jl:JObject" Name="J" />
      <Variable x:TypeArguments="x:String" Name="FailureReason" />
    </Sequence.Variables>

    <Assign DisplayName="Init counters" sap2010:WorkflowViewState.IdRef="Assign_InitCounters">
      <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Processed]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Int32">[0]</InArgument></Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log start" Level="Info"
      Message="[&quot;SchedulingBot starting. Base=&quot; &amp; in_BaseUrl &amp; &quot; MaxTx=&quot; &amp; in_MaxTransactions.ToString()]"
      sap2010:WorkflowViewState.IdRef="Log_Start" />

    <ui:InvokeWorkflowFile DisplayName="GET pending booking requests"
      sap2010:WorkflowViewState.IdRef="Invoke_GetPending"
      WorkflowFileName="..\..\shared\HMS_Client.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
        <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_Method">["GET"]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/booking-requests?queue_status=PENDING_PUSH&amp;limit=" &amp; in_MaxTransactions.ToString()]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_Body">[""]</InArgument>
        <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[3]</InArgument>
        <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>

    <If DisplayName="Failed to fetch pending"
      Condition="[StatusCode &lt; 200 OrElse StatusCode &gt;= 300]"
      sap2010:WorkflowViewState.IdRef="If_FetchFail">
      <If.Then>
        <Throw
          Exception="[New System.InvalidOperationException(&quot;Could not fetch pending booking requests: &quot; &amp; ErrorCode)]"
          sap2010:WorkflowViewState.IdRef="Throw_Fetch" />
      </If.Then>
    </If>

    <Assign DisplayName="Parse pending"
      sap2010:WorkflowViewState.IdRef="Assign_ParsePending">
      <Assign.To><OutArgument x:TypeArguments="jl:JArray">[Pending]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="jl:JArray">[Newtonsoft.Json.Linq.JArray.Parse(ResponseJson)]</InArgument></Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log pending count" Level="Info"
      Message="[&quot;Found &quot; &amp; Pending.Count.ToString() &amp; &quot; pending booking requests&quot;]"
      sap2010:WorkflowViewState.IdRef="Log_PendCount" />

    <While DisplayName="Process each request"
      Condition="[Idx &lt; Pending.Count AndAlso (out_Processed + out_Failed) &lt; in_MaxTransactions]"
      sap2010:WorkflowViewState.IdRef="While_Loop">
      <Sequence sap2010:WorkflowViewState.IdRef="Seq_Tx">

        <Assign DisplayName="Current request" sap2010:WorkflowViewState.IdRef="Assign_Current">
          <Assign.To><OutArgument x:TypeArguments="jl:JObject">[CurrentReq]</OutArgument></Assign.To>
          <Assign.Value><InArgument x:TypeArguments="jl:JObject">[CType(Pending(Idx), Newtonsoft.Json.Linq.JObject)]</InArgument></Assign.Value>
        </Assign>

        <Assign DisplayName="Extract RequestRef" sap2010:WorkflowViewState.IdRef="Assign_Ref">
          <Assign.To><OutArgument x:TypeArguments="x:String">[RequestRef]</OutArgument></Assign.To>
          <Assign.Value><InArgument x:TypeArguments="x:String">[CurrentReq("RequestId").ToString()]</InArgument></Assign.Value>
        </Assign>

        <ui:LogMessage DisplayName="Log tx start" Level="Info"
          Message="[&quot;Transaction &quot; &amp; (Idx + 1).ToString() &amp; &quot;/&quot; &amp; Pending.Count.ToString() &amp; &quot; ref=&quot; &amp; RequestRef]"
          sap2010:WorkflowViewState.IdRef="Log_TxStart" />

        <TryCatch DisplayName="Process transaction" sap2010:WorkflowViewState.IdRef="Try_Tx">
          <TryCatch.Try>
            <Sequence sap2010:WorkflowViewState.IdRef="Seq_Process">

              <!-- Extract fields -->
              <Sequence DisplayName="Step 1 - Extract and validate" sap2010:WorkflowViewState.IdRef="Seq_Extract">
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Phone">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[Phone]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[CurrentReq("Phone").ToString()]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Email">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[Email]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[If(CurrentReq("Email") Is Nothing, "", CurrentReq("Email").ToString())]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_PName">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[PatientName]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[CurrentReq("PatientName").ToString()]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Dept">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[Department]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[CurrentReq("Department").ToString()]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Urg">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[Urgency]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[CurrentReq("Urgency").ToString().ToUpper()]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Band">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[TimeBand]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[If(CurrentReq("TimeBand") Is Nothing, "ANY", CurrentReq("TimeBand").ToString().ToUpper())]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_DFrom">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[DateFrom]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[CurrentReq("PreferredDateFrom").ToString()]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_DTo">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[DateTo]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[CurrentReq("PreferredDateTo").ToString()]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Follow">
                  <Assign.To><OutArgument x:TypeArguments="x:Boolean">[IsFollowUp]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Boolean">[CurrentReq("IsFollowUp") IsNot Nothing AndAlso Boolean.Parse(CurrentReq("IsFollowUp").ToString())]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Reason">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[Reason]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[If(CurrentReq("Reason") Is Nothing, "", CurrentReq("Reason").ToString())]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_PrefDoc">
                  <Assign.To><OutArgument x:TypeArguments="x:Int32">[PreferredDoctorId]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Int32">[If(CurrentReq("PreferredDoctor") Is Nothing OrElse CurrentReq("PreferredDoctor").ToString().Equals("Any", StringComparison.OrdinalIgnoreCase) OrElse Not Integer.TryParse(CurrentReq("PreferredDoctor").ToString(), 0), 0, Integer.Parse(CurrentReq("PreferredDoctor").ToString()))]</InArgument></Assign.Value>
                </Assign>

                <If DisplayName="Validate phone E.164"
                  Condition="[Not Regex.IsMatch(Phone, &quot;^\+[1-9]\d{9,14}$&quot;)]"
                  sap2010:WorkflowViewState.IdRef="If_ValPhone">
                  <If.Then>
                    <Throw
                      Exception="[New UiPath.Core.BusinessRuleException(&quot;VALIDATION_ERROR: phone not E.164&quot;)]"
                      sap2010:WorkflowViewState.IdRef="Throw_Phone" />
                  </If.Then>
                </If>

                <If DisplayName="Validate date range"
                  Condition="[Date.Parse(DateFrom) &gt; Date.Parse(DateTo)]"
                  sap2010:WorkflowViewState.IdRef="If_ValDate">
                  <If.Then>
                    <Throw
                      Exception="[New UiPath.Core.BusinessRuleException(&quot;VALIDATION_ERROR: date range reversed&quot;)]"
                      sap2010:WorkflowViewState.IdRef="Throw_Date" />
                  </If.Then>
                </If>

                <If DisplayName="Validate urgency"
                  Condition="[Urgency &lt;&gt; &quot;NORMAL&quot; AndAlso Urgency &lt;&gt; &quot;HIGH&quot; AndAlso Urgency &lt;&gt; &quot;URGENT&quot;]"
                  sap2010:WorkflowViewState.IdRef="If_ValUrg">
                  <If.Then>
                    <Throw
                      Exception="[New UiPath.Core.BusinessRuleException(&quot;VALIDATION_ERROR: urgency not one of NORMAL/HIGH/URGENT&quot;)]"
                      sap2010:WorkflowViewState.IdRef="Throw_Urg" />
                  </If.Then>
                </If>
              </Sequence>

              <!-- Find or register patient -->
              <Sequence DisplayName="Step 2 - Find or register patient" sap2010:WorkflowViewState.IdRef="Seq_Patient">
                <ui:InvokeWorkflowFile DisplayName="GET patients by phone"
                  sap2010:WorkflowViewState.IdRef="Invoke_GetPatient"
                  WorkflowFileName="..\..\shared\HMS_Client.xaml">
                  <ui:InvokeWorkflowFile.Arguments>
                    <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                    <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                    <InArgument x:TypeArguments="x:String" x:Key="in_Method">["GET"]</InArgument>
                    <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/patients?phone=" &amp; System.Net.WebUtility.UrlEncode(Phone)]</InArgument>
                    <InArgument x:TypeArguments="x:String" x:Key="in_Body">[""]</InArgument>
                    <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[3]</InArgument>
                    <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                    <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                    <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                    <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                  </ui:InvokeWorkflowFile.Arguments>
                </ui:InvokeWorkflowFile>

                <If DisplayName="Patient found?"
                  Condition="[Not String.IsNullOrWhiteSpace(ResponseJson) AndAlso Newtonsoft.Json.Linq.JArray.Parse(ResponseJson).Count &gt; 0]"
                  sap2010:WorkflowViewState.IdRef="If_PatFound">
                  <If.Then>
                    <Sequence sap2010:WorkflowViewState.IdRef="Seq_PatFound">
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_PatObj">
                        <Assign.To><OutArgument x:TypeArguments="jl:JObject">[J]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="jl:JObject">[CType(Newtonsoft.Json.Linq.JArray.Parse(ResponseJson)(0), Newtonsoft.Json.Linq.JObject)]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_PatId">
                        <Assign.To><OutArgument x:TypeArguments="x:Int32">[PatientId]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Int32">[Integer.Parse(J("patient_id").ToString())]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_PatAge">
                        <Assign.To><OutArgument x:TypeArguments="x:Int32">[PatientAge]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Int32">[Integer.Parse(J("age").ToString())]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_PatCh">
                        <Assign.To><OutArgument x:TypeArguments="x:String">[PatientChannel]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:String">[J("preferred_channel").ToString()]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_PatSMS">
                        <Assign.To><OutArgument x:TypeArguments="x:Boolean">[SmsConsent]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Boolean">[Boolean.Parse(J("sms_consent").ToString())]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_PatEml">
                        <Assign.To><OutArgument x:TypeArguments="x:Boolean">[EmailConsent]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Boolean">[Boolean.Parse(J("email_consent").ToString())]</InArgument></Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Then>
                  <If.Else>
                    <Sequence DisplayName="Register new patient" sap2010:WorkflowViewState.IdRef="Seq_Register">
                      <ui:InvokeWorkflowFile DisplayName="POST patients"
                        sap2010:WorkflowViewState.IdRef="Invoke_RegPat"
                        WorkflowFileName="..\..\shared\HMS_Client.xaml">
                        <ui:InvokeWorkflowFile.Arguments>
                          <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                          <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Method">["POST"]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/patients"]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Body">[New Newtonsoft.Json.Linq.JObject(New Newtonsoft.Json.Linq.JProperty("full_name", PatientName), New Newtonsoft.Json.Linq.JProperty("phone", Phone), New Newtonsoft.Json.Linq.JProperty("email", Email), New Newtonsoft.Json.Linq.JProperty("date_of_birth", DateTime.Today.AddYears(-35).ToString("yyyy-MM-dd")), New Newtonsoft.Json.Linq.JProperty("gender", "O"), New Newtonsoft.Json.Linq.JProperty("preferred_channel", If(String.IsNullOrEmpty(Email), "SMS", "SMS"))).ToString()]</InArgument>
                          <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[3]</InArgument>
                          <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                          <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                          <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                          <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                        </ui:InvokeWorkflowFile.Arguments>
                      </ui:InvokeWorkflowFile>

                      <If Condition="[StatusCode &lt; 200 OrElse StatusCode &gt;= 300]"
                        sap2010:WorkflowViewState.IdRef="If_RegFail">
                        <If.Then>
                          <Throw
                            Exception="[New UiPath.Core.BusinessRuleException(&quot;PATIENT_REGISTRATION_FAILED: &quot; &amp; ErrorCode)]"
                            sap2010:WorkflowViewState.IdRef="Throw_Reg" />
                        </If.Then>
                      </If>

                      <Assign sap2010:WorkflowViewState.IdRef="Assign_NewPat">
                        <Assign.To><OutArgument x:TypeArguments="jl:JObject">[J]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="jl:JObject">[Newtonsoft.Json.Linq.JObject.Parse(ResponseJson)]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_NewPatId">
                        <Assign.To><OutArgument x:TypeArguments="x:Int32">[PatientId]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Int32">[Integer.Parse(J("patient_id").ToString())]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_NewPatAge">
                        <Assign.To><OutArgument x:TypeArguments="x:Int32">[PatientAge]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Int32">[Integer.Parse(J("age").ToString())]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_NewPatCh">
                        <Assign.To><OutArgument x:TypeArguments="x:String">[PatientChannel]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:String">[J("preferred_channel").ToString()]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_NewPatSMS">
                        <Assign.To><OutArgument x:TypeArguments="x:Boolean">[SmsConsent]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_NewPatEml">
                        <Assign.To><OutArgument x:TypeArguments="x:Boolean">[EmailConsent]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Boolean">[Not String.IsNullOrEmpty(Email)]</InArgument></Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Else>
                </If>
              </Sequence>

              <!-- Derive priority -->
              <Sequence DisplayName="Step 3 - Derive priority" sap2010:WorkflowViewState.IdRef="Seq_Prio">
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Prio">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[Priority]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[If(Urgency = "URGENT", "URGENT", If(Urgency = "HIGH" OrElse PatientAge &gt;= 60 OrElse IsFollowUp, "HIGH", "NORMAL"))]</InArgument></Assign.Value>
                </Assign>
                <ui:LogMessage DisplayName="Log priority" Level="Info"
                  Message="[&quot;Priority=&quot; &amp; Priority &amp; &quot; age=&quot; &amp; PatientAge.ToString() &amp; &quot; followup=&quot; &amp; IsFollowUp.ToString()]"
                  sap2010:WorkflowViewState.IdRef="Log_Prio" />
              </Sequence>

              <!-- Search slots -->
              <Sequence DisplayName="Step 4 - Search slots" sap2010:WorkflowViewState.IdRef="Seq_Search">
                <ui:InvokeWorkflowFile DisplayName="GET slots"
                  sap2010:WorkflowViewState.IdRef="Invoke_GetSlots"
                  WorkflowFileName="..\..\shared\HMS_Client.xaml">
                  <ui:InvokeWorkflowFile.Arguments>
                    <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                    <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                    <InArgument x:TypeArguments="x:String" x:Key="in_Method">["GET"]</InArgument>
                    <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/slots?department=" &amp; Department &amp; "&amp;date_from=" &amp; DateFrom &amp; "&amp;date_to=" &amp; DateTo &amp; "&amp;status=AVAILABLE&amp;include_reserve=" &amp; If(Priority = "URGENT", "true", "false") &amp; "&amp;limit=500"]</InArgument>
                    <InArgument x:TypeArguments="x:String" x:Key="in_Body">[""]</InArgument>
                    <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[3]</InArgument>
                    <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                    <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                    <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                    <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                  </ui:InvokeWorkflowFile.Arguments>
                </ui:InvokeWorkflowFile>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Slots">
                  <Assign.To><OutArgument x:TypeArguments="jl:JArray">[Slots]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="jl:JArray">[Newtonsoft.Json.Linq.JArray.Parse(ResponseJson)]</InArgument></Assign.Value>
                </Assign>
                <If Condition="[Slots.Count = 0]" sap2010:WorkflowViewState.IdRef="If_NoSlots">
                  <If.Then>
                    <Throw
                      Exception="[New UiPath.Core.BusinessRuleException(&quot;NO_SLOT_AVAILABLE: no available slots in window&quot;)]"
                      sap2010:WorkflowViewState.IdRef="Throw_NoSlots" />
                  </If.Then>
                </If>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Excl">
                  <Assign.To><OutArgument x:TypeArguments="scg:List(x:Int32)">[ExcludedSlots]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="scg:List(x:Int32)">[New System.Collections.Generic.List(Of Integer)()]</InArgument></Assign.Value>
                </Assign>
              </Sequence>

              <!-- Lock/book with retry -->
              <Sequence DisplayName="Step 5 - Allocate, lock and book" sap2010:WorkflowViewState.IdRef="Seq_Book">
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Attempts">
                  <Assign.To><OutArgument x:TypeArguments="x:Int32">[AttemptsUsed]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Int32">[0]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Booked">
                  <Assign.To><OutArgument x:TypeArguments="x:Boolean">[Booked]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
                </Assign>

                <While Condition="[Not Booked AndAlso AttemptsUsed &lt; in_MaxRetryAttempts]"
                  sap2010:WorkflowViewState.IdRef="While_Book">
                  <Sequence sap2010:WorkflowViewState.IdRef="Seq_OneAttempt">
                    <Assign sap2010:WorkflowViewState.IdRef="Assign_IncAtt">
                      <Assign.To><OutArgument x:TypeArguments="x:Int32">[AttemptsUsed]</OutArgument></Assign.To>
                      <Assign.Value><InArgument x:TypeArguments="x:Int32">[AttemptsUsed + 1]</InArgument></Assign.Value>
                    </Assign>

                    <ui:InvokeWorkflowFile DisplayName="Allocate best slot"
                      sap2010:WorkflowViewState.IdRef="Invoke_Alloc"
                      WorkflowFileName="Workflows\AllocateSlot.xaml">
                      <ui:InvokeWorkflowFile.Arguments>
                        <InArgument x:TypeArguments="jl:JArray" x:Key="in_Slots">[Slots]</InArgument>
                        <InArgument x:TypeArguments="scg:List(x:Int32)" x:Key="in_ExcludedSlotIds">[ExcludedSlots]</InArgument>
                        <InArgument x:TypeArguments="x:String" x:Key="in_Priority">[Priority]</InArgument>
                        <InArgument x:TypeArguments="x:Int32" x:Key="in_PreferredDoctorId">[PreferredDoctorId]</InArgument>
                        <InArgument x:TypeArguments="x:String" x:Key="in_TimeBand">[TimeBand]</InArgument>
                        <OutArgument x:TypeArguments="jl:JObject" x:Key="out_SelectedSlot">[SelectedSlot]</OutArgument>
                        <OutArgument x:TypeArguments="x:Int32" x:Key="out_SelectedSlotId">[SelectedSlotId]</OutArgument>
                        <OutArgument x:TypeArguments="x:Int32" x:Key="out_SelectedSlotVersion">[SelectedSlotVersion]</OutArgument>
                        <OutArgument x:TypeArguments="x:Int32" x:Key="out_AllocationPass">[AllocationPass]</OutArgument>
                      </ui:InvokeWorkflowFile.Arguments>
                    </ui:InvokeWorkflowFile>

                    <If Condition="[SelectedSlotId = 0]" sap2010:WorkflowViewState.IdRef="If_NoAlloc">
                      <If.Then>
                        <Throw
                          Exception="[New UiPath.Core.BusinessRuleException(&quot;NO_SLOT_AVAILABLE: allocation returned no candidate&quot;)]"
                          sap2010:WorkflowViewState.IdRef="Throw_NoAlloc" />
                      </If.Then>
                    </If>

                    <TryCatch DisplayName="Lock, recheck, book" sap2010:WorkflowViewState.IdRef="Try_Book">
                      <TryCatch.Try>
                        <Sequence sap2010:WorkflowViewState.IdRef="Seq_LockBook">

                          <ui:InvokeWorkflowFile DisplayName="Lock slot"
                            sap2010:WorkflowViewState.IdRef="Invoke_Lock"
                            WorkflowFileName="..\..\shared\HMS_Client.xaml">
                            <ui:InvokeWorkflowFile.Arguments>
                              <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                              <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_Method">["POST"]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/slots/" &amp; SelectedSlotId.ToString() &amp; "/lock"]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_Body">[&quot;{&quot;&quot;locked_by&quot;&quot;:&quot;&quot;SchedulingBot&quot;&quot;}&quot;]</InArgument>
                              <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                              <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                            </ui:InvokeWorkflowFile.Arguments>
                          </ui:InvokeWorkflowFile>

                          <If DisplayName="Lock failed?"
                            Condition="[StatusCode &lt; 200 OrElse StatusCode &gt;= 300]"
                            sap2010:WorkflowViewState.IdRef="If_LockFail">
                            <If.Then>
                              <Sequence sap2010:WorkflowViewState.IdRef="Seq_LockFail">
                                <ui:LogMessage Level="Warn"
                                  Message="[&quot;Lock failed slot=&quot; &amp; SelectedSlotId.ToString() &amp; &quot; err=&quot; &amp; ErrorCode]"
                                  sap2010:WorkflowViewState.IdRef="Log_LockFail" />
                                <InvokeMethod MethodName="Add"
                                  sap2010:WorkflowViewState.IdRef="Add_Excl_Lock">
                                  <InvokeMethod.TargetObject>
                                    <InArgument x:TypeArguments="scg:List(x:Int32)">[ExcludedSlots]</InArgument>
                                  </InvokeMethod.TargetObject>
                                  <InvokeMethod.Parameters>
                                    <InArgument x:TypeArguments="x:Int32">[SelectedSlotId]</InArgument>
                                  </InvokeMethod.Parameters>
                                </InvokeMethod>
                              </Sequence>
                            </If.Then>
                            <If.Else>
                              <Sequence DisplayName="Recheck and book" sap2010:WorkflowViewState.IdRef="Seq_ReBook">
                                <!-- Book -->
                                <ui:InvokeWorkflowFile DisplayName="POST appointment"
                                  sap2010:WorkflowViewState.IdRef="Invoke_Book"
                                  WorkflowFileName="..\..\shared\HMS_Client.xaml">
                                  <ui:InvokeWorkflowFile.Arguments>
                                    <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                                    <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                                    <InArgument x:TypeArguments="x:String" x:Key="in_Method">["POST"]</InArgument>
                                    <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/appointments"]</InArgument>
                                    <InArgument x:TypeArguments="x:String" x:Key="in_Body">[New Newtonsoft.Json.Linq.JObject(New Newtonsoft.Json.Linq.JProperty("patient_id", PatientId), New Newtonsoft.Json.Linq.JProperty("slot_id", SelectedSlotId), New Newtonsoft.Json.Linq.JProperty("priority", Priority), New Newtonsoft.Json.Linq.JProperty("reason", Reason), New Newtonsoft.Json.Linq.JProperty("is_follow_up", IsFollowUp), New Newtonsoft.Json.Linq.JProperty("queue_item_ref", RequestRef), New Newtonsoft.Json.Linq.JProperty("booked_by", "SchedulingBot")).ToString()]</InArgument>
                                    <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                                    <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                                    <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                                    <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                                    <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                                  </ui:InvokeWorkflowFile.Arguments>
                                </ui:InvokeWorkflowFile>

                                <If Condition="[StatusCode &gt;= 200 AndAlso StatusCode &lt; 300]"
                                  sap2010:WorkflowViewState.IdRef="If_BookOk">
                                  <If.Then>
                                    <Sequence sap2010:WorkflowViewState.IdRef="Seq_BookOk">
                                      <Assign sap2010:WorkflowViewState.IdRef="Assign_ApptObj">
                                        <Assign.To><OutArgument x:TypeArguments="jl:JObject">[J]</OutArgument></Assign.To>
                                        <Assign.Value><InArgument x:TypeArguments="jl:JObject">[Newtonsoft.Json.Linq.JObject.Parse(ResponseJson)]</InArgument></Assign.Value>
                                      </Assign>
                                      <Assign sap2010:WorkflowViewState.IdRef="Assign_ApptId">
                                        <Assign.To><OutArgument x:TypeArguments="x:Int32">[AppointmentId]</OutArgument></Assign.To>
                                        <Assign.Value><InArgument x:TypeArguments="x:Int32">[Integer.Parse(J("appointment_id").ToString())]</InArgument></Assign.Value>
                                      </Assign>
                                      <Assign sap2010:WorkflowViewState.IdRef="Assign_ApptRef">
                                        <Assign.To><OutArgument x:TypeArguments="x:String">[AppointmentRef]</OutArgument></Assign.To>
                                        <Assign.Value><InArgument x:TypeArguments="x:String">[J("reference_no").ToString()]</InArgument></Assign.Value>
                                      </Assign>
                                      <Assign sap2010:WorkflowViewState.IdRef="Assign_ApptDt">
                                        <Assign.To><OutArgument x:TypeArguments="x:String">[AppointmentDateTime]</OutArgument></Assign.To>
                                        <Assign.Value><InArgument x:TypeArguments="x:String">[J("appointment_datetime").ToString()]</InArgument></Assign.Value>
                                      </Assign>
                                      <Assign sap2010:WorkflowViewState.IdRef="Assign_ApptDoc">
                                        <Assign.To><OutArgument x:TypeArguments="x:String">[DoctorName]</OutArgument></Assign.To>
                                        <Assign.Value><InArgument x:TypeArguments="x:String">[J("doctor_name").ToString()]</InArgument></Assign.Value>
                                      </Assign>
                                      <Assign sap2010:WorkflowViewState.IdRef="Assign_BookedTrue">
                                        <Assign.To><OutArgument x:TypeArguments="x:Boolean">[Booked]</OutArgument></Assign.To>
                                        <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
                                      </Assign>
                                    </Sequence>
                                  </If.Then>
                                  <If.Else>
                                    <Sequence sap2010:WorkflowViewState.IdRef="Seq_BookFail">
                                      <ui:LogMessage Level="Warn"
                                        Message="[&quot;Book failed slot=&quot; &amp; SelectedSlotId.ToString() &amp; &quot; err=&quot; &amp; ErrorCode]"
                                        sap2010:WorkflowViewState.IdRef="Log_BookFail" />
                                      <If Condition="[ErrorCode = &quot;SLOT_TAKEN&quot; OrElse ErrorCode = &quot;SLOT_LOCKED&quot;]"
                                        sap2010:WorkflowViewState.IdRef="If_SlotContended">
                                        <If.Then>
                                          <InvokeMethod MethodName="Add"
                                            sap2010:WorkflowViewState.IdRef="Add_Excl_Book">
                                            <InvokeMethod.TargetObject>
                                              <InArgument x:TypeArguments="scg:List(x:Int32)">[ExcludedSlots]</InArgument>
                                            </InvokeMethod.TargetObject>
                                            <InvokeMethod.Parameters>
                                              <InArgument x:TypeArguments="x:Int32">[SelectedSlotId]</InArgument>
                                            </InvokeMethod.Parameters>
                                          </InvokeMethod>
                                        </If.Then>
                                        <If.Else>
                                          <Throw
                                            Exception="[New UiPath.Core.BusinessRuleException(&quot;BOOK_FAILED: &quot; &amp; ErrorCode)]"
                                            sap2010:WorkflowViewState.IdRef="Throw_Book" />
                                        </If.Else>
                                      </If>
                                    </Sequence>
                                  </If.Else>
                                </If>
                              </Sequence>
                            </If.Else>
                          </If>
                        </Sequence>
                      </TryCatch.Try>
                      <TryCatch.Finally>
                        <Sequence DisplayName="Release lock (always)" sap2010:WorkflowViewState.IdRef="Seq_Release">
                          <ui:InvokeWorkflowFile DisplayName="POST release"
                            sap2010:WorkflowViewState.IdRef="Invoke_Release"
                            WorkflowFileName="..\..\shared\HMS_Client.xaml">
                            <ui:InvokeWorkflowFile.Arguments>
                              <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                              <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_Method">["POST"]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/slots/" &amp; SelectedSlotId.ToString() &amp; "/release"]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_Body">[&quot;{&quot;&quot;locked_by&quot;&quot;:&quot;&quot;SchedulingBot&quot;&quot;}&quot;]</InArgument>
                              <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[1]</InArgument>
                              <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                            </ui:InvokeWorkflowFile.Arguments>
                          </ui:InvokeWorkflowFile>
                        </Sequence>
                      </TryCatch.Finally>
                    </TryCatch>
                  </Sequence>
                </While>

                <If Condition="[Not Booked]" sap2010:WorkflowViewState.IdRef="If_NotBooked">
                  <If.Then>
                    <Throw
                      Exception="[New UiPath.Core.BusinessRuleException(&quot;SLOT_CONTENTION: could not book after &quot; &amp; AttemptsUsed.ToString() &amp; &quot; attempts&quot;)]"
                      sap2010:WorkflowViewState.IdRef="Throw_NotBooked" />
                  </If.Then>
                </If>
              </Sequence>

              <!-- Excel mirroring is done out-of-band by tools/excel_mirror.py sync.
                   Studio 26's Modern Excel activities live in a different package
                   than the classic ones, and pinning it here would break Studio
                   for anyone on a slightly different pack version. Keeping the
                   bot free of that dependency; the reconciler is the source of
                   truth for the Excel copy. -->

              <!-- Send confirmation -->
              <Sequence DisplayName="Step 7 - Confirmation" sap2010:WorkflowViewState.IdRef="Seq_Conf">
                <Assign sap2010:WorkflowViewState.IdRef="Assign_ConfChan">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[NotificationChannel]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[If(PatientChannel = "SMS" AndAlso SmsConsent, "SMS", If(PatientChannel = "EMAIL" AndAlso EmailConsent AndAlso Not String.IsNullOrEmpty(Email), "EMAIL", If(SmsConsent, "SMS", If(EmailConsent AndAlso Not String.IsNullOrEmpty(Email), "EMAIL", "NONE"))))]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_MsgBody">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[MsgBody]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">[in_HospitalName &amp; ": appointment " &amp; AppointmentRef &amp; " with " &amp; DoctorName &amp; " on " &amp; AppointmentDateTime.Replace("T", " ") &amp; ". Reply STOP to unsubscribe."]</InArgument></Assign.Value>
                </Assign>

                <TryCatch sap2010:WorkflowViewState.IdRef="Try_Notif">
                  <TryCatch.Try>
                    <Sequence sap2010:WorkflowViewState.IdRef="Seq_NotifSend">
                      <If Condition="[NotificationChannel = &quot;SMS&quot;]" sap2010:WorkflowViewState.IdRef="If_ChSMS">
                        <If.Then>
                          <ui:InvokeWorkflowFile DisplayName="Send SMS"
                            sap2010:WorkflowViewState.IdRef="Invoke_SMS"
                            WorkflowFileName="..\..\shared\SendSMS.xaml">
                            <ui:InvokeWorkflowFile.Arguments>
                              <InArgument x:TypeArguments="x:String" x:Key="in_To">[Phone]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_Body">[MsgBody]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_AccountSid">[in_TwilioSid]</InArgument>
                              <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_AuthToken">[in_TwilioAuth]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_FromNumber">[in_TwilioFrom]</InArgument>
                              <InArgument x:TypeArguments="x:Boolean" x:Key="in_DryRun">[in_DryRunNotifications]</InArgument>
                              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[NotifOk]</OutArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="out_MessageId">[NotifMessageId]</OutArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[NotifError]</OutArgument>
                              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[NotifRetryable]</OutArgument>
                            </ui:InvokeWorkflowFile.Arguments>
                          </ui:InvokeWorkflowFile>
                        </If.Then>
                        <If.Else>
                          <If Condition="[NotificationChannel = &quot;EMAIL&quot;]" sap2010:WorkflowViewState.IdRef="If_ChEmail">
                            <If.Then>
                              <ui:InvokeWorkflowFile DisplayName="Send Email"
                                sap2010:WorkflowViewState.IdRef="Invoke_Email"
                                WorkflowFileName="..\..\shared\SendEmail.xaml">
                                <ui:InvokeWorkflowFile.Arguments>
                                  <InArgument x:TypeArguments="x:String" x:Key="in_To">[Email]</InArgument>
                                  <InArgument x:TypeArguments="x:String" x:Key="in_Subject">[in_HospitalName &amp; " appointment confirmation " &amp; AppointmentRef]</InArgument>
                                  <InArgument x:TypeArguments="x:String" x:Key="in_HtmlBody">["&lt;p&gt;" &amp; MsgBody &amp; "&lt;/p&gt;"]</InArgument>
                                  <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_SendGridKey]</InArgument>
                                  <InArgument x:TypeArguments="x:String" x:Key="in_FromEmail">[in_SendGridFrom]</InArgument>
                                  <InArgument x:TypeArguments="x:Boolean" x:Key="in_DryRun">[in_DryRunNotifications]</InArgument>
                                  <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[NotifOk]</OutArgument>
                                  <OutArgument x:TypeArguments="x:String" x:Key="out_MessageId">[NotifMessageId]</OutArgument>
                                  <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[NotifError]</OutArgument>
                                  <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[NotifRetryable]</OutArgument>
                                </ui:InvokeWorkflowFile.Arguments>
                              </ui:InvokeWorkflowFile>
                            </If.Then>
                          </If>
                        </If.Else>
                      </If>

                      <If Condition="[NotificationChannel &lt;&gt; &quot;NONE&quot; AndAlso NotifOk]"
                        sap2010:WorkflowViewState.IdRef="If_LogNotif">
                        <If.Then>
                          <ui:InvokeWorkflowFile DisplayName="POST notifications"
                            sap2010:WorkflowViewState.IdRef="Invoke_LogNotif"
                            WorkflowFileName="..\..\shared\HMS_Client.xaml">
                            <ui:InvokeWorkflowFile.Arguments>
                              <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                              <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_Method">["POST"]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/notifications"]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="in_Body">[New Newtonsoft.Json.Linq.JObject(New Newtonsoft.Json.Linq.JProperty("appointment_id", AppointmentId), New Newtonsoft.Json.Linq.JProperty("type", "CONFIRMATION"), New Newtonsoft.Json.Linq.JProperty("channel", NotificationChannel), New Newtonsoft.Json.Linq.JProperty("recipient", If(NotificationChannel = "SMS", Phone, Email)), New Newtonsoft.Json.Linq.JProperty("template_id", "TPL_CONFIRMATION_EN"), New Newtonsoft.Json.Linq.JProperty("status", "SENT"), New Newtonsoft.Json.Linq.JProperty("provider", If(in_DryRunNotifications, "DRYRUN", If(NotificationChannel = "SMS", "TWILIO", "SENDGRID"))), New Newtonsoft.Json.Linq.JProperty("provider_message_id", NotifMessageId), New Newtonsoft.Json.Linq.JProperty("body_preview", MsgBody.Substring(0, Math.Min(200, MsgBody.Length)))).ToString()]</InArgument>
                              <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                              <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                            </ui:InvokeWorkflowFile.Arguments>
                          </ui:InvokeWorkflowFile>
                        </If.Then>
                      </If>
                    </Sequence>
                  </TryCatch.Try>
                  <TryCatch.Catches>
                    <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_Notif">
                      <ActivityAction x:TypeArguments="s:Exception">
                        <ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="ex" /></ActivityAction.Argument>
                        <ui:LogMessage Level="Warn"
                          Message="[&quot;Confirmation failed (non-fatal): &quot; &amp; ex.Message]"
                          sap2010:WorkflowViewState.IdRef="Log_NotifFail" />
                      </ActivityAction>
                    </Catch>
                  </TryCatch.Catches>
                </TryCatch>
              </Sequence>

              <!-- Mark PROCESSED -->
              <ui:InvokeWorkflowFile DisplayName="PATCH booking-request PROCESSED"
                sap2010:WorkflowViewState.IdRef="Invoke_MarkOk"
                WorkflowFileName="..\..\shared\HMS_Client.xaml">
                <ui:InvokeWorkflowFile.Arguments>
                  <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                  <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="in_Method">["PATCH"]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/booking-requests/" &amp; RequestRef]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="in_Body">[&quot;{&quot;&quot;queue_status&quot;&quot;:&quot;&quot;PROCESSED&quot;&quot;}&quot;]</InArgument>
                  <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                  <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                  <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                </ui:InvokeWorkflowFile.Arguments>
              </ui:InvokeWorkflowFile>

              <Assign DisplayName="Increment processed" sap2010:WorkflowViewState.IdRef="Assign_IncOk">
                <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Processed]</OutArgument></Assign.To>
                <Assign.Value><InArgument x:TypeArguments="x:Int32">[out_Processed + 1]</InArgument></Assign.Value>
              </Assign>

              <ui:LogMessage DisplayName="Log tx success" Level="Info"
                Message="[&quot;Booked &quot; &amp; AppointmentRef &amp; &quot; on &quot; &amp; AppointmentDateTime &amp; &quot; with &quot; &amp; DoctorName &amp; &quot; (pass &quot; &amp; AllocationPass.ToString() &amp; &quot;)&quot;]"
                sap2010:WorkflowViewState.IdRef="Log_TxOk" />

            </Sequence>
          </TryCatch.Try>
          <TryCatch.Catches>
            <Catch x:TypeArguments="ui:BusinessRuleException" sap2010:WorkflowViewState.IdRef="Catch_Biz">
              <ActivityAction x:TypeArguments="ui:BusinessRuleException">
                <ActivityAction.Argument><DelegateInArgument x:TypeArguments="ui:BusinessRuleException" Name="bex" /></ActivityAction.Argument>
                <Sequence sap2010:WorkflowViewState.IdRef="Seq_BizFail">
                  <Assign sap2010:WorkflowViewState.IdRef="Assign_FailReason">
                    <Assign.To><OutArgument x:TypeArguments="x:String">[FailureReason]</OutArgument></Assign.To>
                    <Assign.Value><InArgument x:TypeArguments="x:String">[bex.Message]</InArgument></Assign.Value>
                  </Assign>
                  <ui:LogMessage Level="Warn"
                    Message="[&quot;Business exception ref=&quot; &amp; RequestRef &amp; &quot;: &quot; &amp; FailureReason]"
                    sap2010:WorkflowViewState.IdRef="Log_Biz" />
                  <ui:InvokeWorkflowFile DisplayName="PATCH booking-request FAILED"
                    sap2010:WorkflowViewState.IdRef="Invoke_MarkFail"
                    WorkflowFileName="..\..\shared\HMS_Client.xaml">
                    <ui:InvokeWorkflowFile.Arguments>
                      <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                      <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_Method">["PATCH"]</InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/booking-requests/" &amp; RequestRef]</InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_Body">[New Newtonsoft.Json.Linq.JObject(New Newtonsoft.Json.Linq.JProperty("queue_status", "FAILED"), New Newtonsoft.Json.Linq.JProperty("push_error", FailureReason)).ToString()]</InArgument>
                      <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                      <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                      <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                    </ui:InvokeWorkflowFile.Arguments>
                  </ui:InvokeWorkflowFile>
                  <Assign sap2010:WorkflowViewState.IdRef="Assign_IncFail">
                    <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Failed]</OutArgument></Assign.To>
                    <Assign.Value><InArgument x:TypeArguments="x:Int32">[out_Failed + 1]</InArgument></Assign.Value>
                  </Assign>
                </Sequence>
              </ActivityAction>
            </Catch>
            <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_Sys">
              <ActivityAction x:TypeArguments="s:Exception">
                <ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="ex" /></ActivityAction.Argument>
                <Sequence sap2010:WorkflowViewState.IdRef="Seq_SysFail">
                  <ui:LogMessage Level="Error"
                    Message="[&quot;System exception ref=&quot; &amp; RequestRef &amp; &quot;: &quot; &amp; ex.Message]"
                    sap2010:WorkflowViewState.IdRef="Log_Sys" />
                  <Rethrow sap2010:WorkflowViewState.IdRef="Rethrow_Sys" />
                </Sequence>
              </ActivityAction>
            </Catch>
          </TryCatch.Catches>
        </TryCatch>

        <Assign DisplayName="Advance index" sap2010:WorkflowViewState.IdRef="Assign_NextIdx">
          <Assign.To><OutArgument x:TypeArguments="x:Int32">[Idx]</OutArgument></Assign.To>
          <Assign.Value><InArgument x:TypeArguments="x:Int32">[Idx + 1]</InArgument></Assign.Value>
        </Assign>
      </Sequence>
    </While>

    <ui:LogMessage DisplayName="Log finished" Level="Info"
      Message="[&quot;SchedulingBot finished. Processed=&quot; &amp; out_Processed.ToString() &amp; &quot; Failed=&quot; &amp; out_Failed.ToString()]"
      sap2010:WorkflowViewState.IdRef="Log_End" />
  </Sequence>
</Activity>
