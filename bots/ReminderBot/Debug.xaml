      <x:String>GlobalConstantsNamespace</x:String>
      <x:String>GlobalVariablesNamespace</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference" Capacity="8">
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>
  <Sequence sap2010:Annotation.AnnotationText="Click Debug File (F6) on THIS workflow. It calls Main.xaml with hardcoded values, which sidesteps Studio's Arguments panel. in_NowOverride is empty by default → uses DateTime.Now. Set it to a specific T-24h or T-2h time matching a seeded appointment (see /admin/schedule) if you want sent reminders rather than 0. Prereq: Mock HMS running at http://localhost:5000 with REQUIRE_API_KEY=false." DisplayName="Debug launcher" sap2010:WorkflowViewState.IdRef="Seq_Root">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="Sent" />
      <Variable x:TypeArguments="x:Int32" Name="Skipped" />
      <Variable x:TypeArguments="x:Int32" Name="Failed" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Run ReminderBot Main" sap2010:WorkflowViewState.IdRef="Invoke_Main" UnSafe="False" WorkflowFileName="Main.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">["http://localhost:5000"]</InArgument>
        <InArgument x:TypeArguments="ss:SecureString" x:Key="in_ApiKey">[New System.Net.NetworkCredential("", "").SecurePassword]</InArgument>
        <InArgument x:TypeArguments="x:Boolean" x:Key="in_DryRun">[True]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_NowOverride">["2026-10-20T10:00:00"]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_HospitalName">["Meridian General Hospital"]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_TwilioSid">[""]</InArgument>
        <InArgument x:TypeArguments="ss:SecureString" x:Key="in_TwilioAuth">[New System.Net.NetworkCredential("", "").SecurePassword]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_TwilioFrom">[""]</InArgument>
        <InArgument x:TypeArguments="ss:SecureString" x:Key="in_SendGridKey">[New System.Net.NetworkCredential("", "").SecurePassword]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_SendGridFrom">[""]</InArgument>
        <OutArgument x:TypeArguments="x:Int32" x:Key="out_Sent">[Sent]</OutArgument>
        <OutArgument x:TypeArguments="x:Int32" x:Key="out_Skipped">[Skipped]</OutArgument>
        <OutArgument x:TypeArguments="x:Int32" x:Key="out_Failed">[Failed]</OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:LogMessage DisplayName="Log summary" sap2010:WorkflowViewState.IdRef="Log_End" Level="Info" Message="[&quot;Debug run finished. Sent=&quot; &amp; Sent.ToString() &amp; &quot; Skipped=&quot; &amp; Skipped.ToString() &amp; &quot; Failed=&quot; &amp; Failed.ToString()]" />
  </Sequence>
</Activity>