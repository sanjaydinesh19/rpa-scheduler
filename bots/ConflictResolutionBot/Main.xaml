<Activity mc:Ignorable="sap sap2010" x:Class="Main"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:jl="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_BaseUrl" Type="InArgument(x:String)" />
    <x:Property Name="in_ApiKey" Type="InArgument(s:Security.SecureString)" />
    <x:Property Name="in_Mode" Type="InArgument(x:String)" />
    <x:Property Name="in_MaxItems" Type="InArgument(x:Int32)" />
    <x:Property Name="out_Detected" Type="OutArgument(x:Int32)" />
    <x:Property Name="out_Resolved" Type="OutArgument(x:Int32)" />
    <x:Property Name="out_Escalated" Type="OutArgument(x:Int32)" />
  </x:Members>
  <sap2010:ExpressionActivityEditor.ExpressionActivityEditor>VisualBasic</sap2010:ExpressionActivityEditor.ExpressionActivityEditor>
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="8">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>Newtonsoft.Json.Linq</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference" Capacity="8">
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Web.Activities</AssemblyReference>
      <AssemblyReference>Newtonsoft.Json</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>

  <Sequence DisplayName="Conflict Resolution Bot" sap2010:WorkflowViewState.IdRef="Seq_Root">
    <sap2010:Annotation.AnnotationText>CONFLICT RESOLUTION BOT — REST-driven.

Modes:
  SWEEP — detects hidden conflicts (double-bookings and unprocessed doctor
          absences) and RAISES them via /conflicts. Does not resolve.
  QUEUE — reads OPEN conflicts and applies the resolution strategy per type.

Safety rails (all enforced by the HMS reschedule endpoint too):
  - no move inside 4h (TOO_CLOSE_TO_RESCHEDULE)
  - URGENT never auto-moved (URGENT_NEVER_AUTO_MOVED)
  - max 2 automatic moves per appointment (AMBIGUOUS_PRIORITY)

Any conflict the bot cannot resolve with these rails is ESCALATED to a clerk
(status = ESCALATED) — human wins.</sap2010:Annotation.AnnotationText>
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="StatusCode" />
      <Variable x:TypeArguments="x:String" Name="ResponseJson" />
      <Variable x:TypeArguments="x:String" Name="ErrorCode" />
      <Variable x:TypeArguments="x:Boolean" Name="Retryable" />
      <Variable x:TypeArguments="jl:JArray" Name="Conflicts" />
      <Variable x:TypeArguments="jl:JArray" Name="Unavail" />
      <Variable x:TypeArguments="x:Int32" Name="Idx" Default="[0]" />
      <Variable x:TypeArguments="jl:JObject" Name="C" />
      <Variable x:TypeArguments="x:Int32" Name="ConflictId" />
      <Variable x:TypeArguments="x:String" Name="ConflictType" />
      <Variable x:TypeArguments="x:Int32" Name="ApptId" />
      <Variable x:TypeArguments="x:Int32" Name="RelatedApptId" />
      <Variable x:TypeArguments="x:Int32" Name="SlotId" />
      <Variable x:TypeArguments="jl:JObject" Name="J" />
    </Sequence.Variables>

    <Assign DisplayName="Init counters" sap2010:WorkflowViewState.IdRef="Assign_InitR">
      <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Resolved]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Int32">[0]</InArgument></Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log start" Level="Info"
      Message="[&quot;ConflictBot starting mode=&quot; &amp; in_Mode]"
      sap2010:WorkflowViewState.IdRef="Log_Start" />

    <If DisplayName="SWEEP mode" Condition="[in_Mode = &quot;SWEEP&quot;]"
      sap2010:WorkflowViewState.IdRef="If_Sweep">
      <If.Then>
        <Sequence DisplayName="Detect and enqueue" sap2010:WorkflowViewState.IdRef="Seq_Sweep">
          <!-- Detect double-bookings with raise=true -->
          <InvokeWorkflowFile DisplayName="GET detect double-bookings"
            sap2010:WorkflowViewState.IdRef="Invoke_Detect"
            WorkflowFileName="..\..\shared\HMS_Client.xaml">
            <InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
              <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Method">["GET"]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/conflicts/detect/double-bookings?raise=true"]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Body">[""]</InArgument>
              <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[3]</InArgument>
              <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
            </InvokeWorkflowFile.Arguments>
          </InvokeWorkflowFile>

          <Assign sap2010:WorkflowViewState.IdRef="Assign_DetCount">
            <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Detected]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Int32">[If(StatusCode &gt;= 200 AndAlso StatusCode &lt; 300, Newtonsoft.Json.Linq.JArray.Parse(ResponseJson).Count, 0)]</InArgument></Assign.Value>
          </Assign>

          <ui:LogMessage Level="Info"
            Message="[&quot;Sweep detected &quot; &amp; out_Detected.ToString() &amp; &quot; double-booking group(s)&quot;]"
            sap2010:WorkflowViewState.IdRef="Log_Det" />
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Queue mode - resolve" sap2010:WorkflowViewState.IdRef="Seq_Queue">
          <InvokeWorkflowFile DisplayName="GET open conflicts"
            sap2010:WorkflowViewState.IdRef="Invoke_GetOpen"
            WorkflowFileName="..\..\shared\HMS_Client.xaml">
            <InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
              <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Method">["GET"]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/conflicts?status=OPEN&amp;limit=" &amp; in_MaxItems.ToString()]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Body">[""]</InArgument>
              <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[3]</InArgument>
              <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
            </InvokeWorkflowFile.Arguments>
          </InvokeWorkflowFile>

          <Assign sap2010:WorkflowViewState.IdRef="Assign_ConfList">
            <Assign.To><OutArgument x:TypeArguments="jl:JArray">[Conflicts]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="jl:JArray">[If(StatusCode &gt;= 200 AndAlso StatusCode &lt; 300, Newtonsoft.Json.Linq.JArray.Parse(ResponseJson), New Newtonsoft.Json.Linq.JArray())]</InArgument></Assign.Value>
          </Assign>

          <ui:LogMessage Level="Info"
            Message="[&quot;Found &quot; &amp; Conflicts.Count.ToString() &amp; &quot; open conflicts&quot;]"
            sap2010:WorkflowViewState.IdRef="Log_Found" />

          <While Condition="[Idx &lt; Conflicts.Count]" sap2010:WorkflowViewState.IdRef="While_Res">
            <Sequence sap2010:WorkflowViewState.IdRef="Seq_One">
              <Assign sap2010:WorkflowViewState.IdRef="Assign_C">
                <Assign.To><OutArgument x:TypeArguments="jl:JObject">[C]</OutArgument></Assign.To>
                <Assign.Value><InArgument x:TypeArguments="jl:JObject">[CType(Conflicts(Idx), Newtonsoft.Json.Linq.JObject)]</InArgument></Assign.Value>
              </Assign>

              <Assign sap2010:WorkflowViewState.IdRef="Assign_CId">
                <Assign.To><OutArgument x:TypeArguments="x:Int32">[ConflictId]</OutArgument></Assign.To>
                <Assign.Value><InArgument x:TypeArguments="x:Int32">[Integer.Parse(C("conflict_id").ToString())]</InArgument></Assign.Value>
              </Assign>

              <Assign sap2010:WorkflowViewState.IdRef="Assign_CType">
                <Assign.To><OutArgument x:TypeArguments="x:String">[ConflictType]</OutArgument></Assign.To>
                <Assign.Value><InArgument x:TypeArguments="x:String">[C("conflict_type").ToString()]</InArgument></Assign.Value>
              </Assign>

              <Assign sap2010:WorkflowViewState.IdRef="Assign_AId">
                <Assign.To><OutArgument x:TypeArguments="x:Int32">[ApptId]</OutArgument></Assign.To>
                <Assign.Value><InArgument x:TypeArguments="x:Int32">[If(C("appointment_id") Is Nothing OrElse C("appointment_id").Type = Newtonsoft.Json.Linq.JTokenType.Null, 0, Integer.Parse(C("appointment_id").ToString()))]</InArgument></Assign.Value>
              </Assign>

              <Assign sap2010:WorkflowViewState.IdRef="Assign_RId">
                <Assign.To><OutArgument x:TypeArguments="x:Int32">[RelatedApptId]</OutArgument></Assign.To>
                <Assign.Value><InArgument x:TypeArguments="x:Int32">[If(C("related_appointment_id") Is Nothing OrElse C("related_appointment_id").Type = Newtonsoft.Json.Linq.JTokenType.Null, 0, Integer.Parse(C("related_appointment_id").ToString()))]</InArgument></Assign.Value>
              </Assign>

              <Assign sap2010:WorkflowViewState.IdRef="Assign_SlId">
                <Assign.To><OutArgument x:TypeArguments="x:Int32">[SlotId]</OutArgument></Assign.To>
                <Assign.Value><InArgument x:TypeArguments="x:Int32">[If(C("slot_id") Is Nothing OrElse C("slot_id").Type = Newtonsoft.Json.Linq.JTokenType.Null, 0, Integer.Parse(C("slot_id").ToString()))]</InArgument></Assign.Value>
              </Assign>

              <ui:LogMessage Level="Info"
                Message="[&quot;Resolving conflict &quot; &amp; ConflictId.ToString() &amp; &quot; type=&quot; &amp; ConflictType]"
                sap2010:WorkflowViewState.IdRef="Log_Res" />

              <TryCatch sap2010:WorkflowViewState.IdRef="Try_Res">
                <TryCatch.Try>
                  <Switch x:TypeArguments="x:String" Expression="[ConflictType]"
                    sap2010:WorkflowViewState.IdRef="Switch_Type">
                    <Switch.Default>
                      <Sequence sap2010:WorkflowViewState.IdRef="Seq_DefEsc">
                        <InvokeWorkflowFile DisplayName="PATCH escalate default"
                          sap2010:WorkflowViewState.IdRef="Invoke_EscDef"
                          WorkflowFileName="..\..\shared\HMS_Client.xaml">
                          <InvokeWorkflowFile.Arguments>
                            <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                            <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                            <InArgument x:TypeArguments="x:String" x:Key="in_Method">["PATCH"]</InArgument>
                            <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/conflicts/" &amp; ConflictId.ToString()]</InArgument>
                            <InArgument x:TypeArguments="x:String" x:Key="in_Body">[&quot;{&quot;&quot;status&quot;&quot;:&quot;&quot;ESCALATED&quot;&quot;,&quot;&quot;resolution&quot;&quot;:&quot;&quot;UNKNOWN_TYPE&quot;&quot;,&quot;&quot;resolution_note&quot;&quot;:&quot;&quot;Unrecognised conflict type&quot;&quot;}&quot;]</InArgument>
                            <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                            <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                            <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                            <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                            <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                          </InvokeWorkflowFile.Arguments>
                        </InvokeWorkflowFile>
                        <Assign sap2010:WorkflowViewState.IdRef="Assign_EscInc">
                          <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Escalated]</OutArgument></Assign.To>
                          <Assign.Value><InArgument x:TypeArguments="x:Int32">[out_Escalated + 1]</InArgument></Assign.Value>
                        </Assign>
                      </Sequence>
                    </Switch.Default>

                    <!-- DOUBLE_BOOKING: cancel the losing appointment (later-created wins to keep more slots). Both appointments were valid; we cancel the more-recently-booked one and reopen its slot. -->
                    <Sequence x:Key="DOUBLE_BOOKING" sap2010:WorkflowViewState.IdRef="Seq_DB">
                      <If Condition="[RelatedApptId = 0]" sap2010:WorkflowViewState.IdRef="If_DB_NoRel">
                        <If.Then>
                          <Sequence sap2010:WorkflowViewState.IdRef="Seq_DBEsc">
                            <InvokeWorkflowFile DisplayName="PATCH escalate DB(no related)"
                              sap2010:WorkflowViewState.IdRef="Invoke_DBEsc"
                              WorkflowFileName="..\..\shared\HMS_Client.xaml">
                              <InvokeWorkflowFile.Arguments>
                                <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                                <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                                <InArgument x:TypeArguments="x:String" x:Key="in_Method">["PATCH"]</InArgument>
                                <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/conflicts/" &amp; ConflictId.ToString()]</InArgument>
                                <InArgument x:TypeArguments="x:String" x:Key="in_Body">[&quot;{&quot;&quot;status&quot;&quot;:&quot;&quot;ESCALATED&quot;&quot;,&quot;&quot;resolution&quot;&quot;:&quot;&quot;MISSING_RELATED&quot;&quot;,&quot;&quot;resolution_note&quot;&quot;:&quot;&quot;Need the other appointment id to pick a keeper&quot;&quot;}&quot;]</InArgument>
                                <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                                <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                                <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                                <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                                <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                              </InvokeWorkflowFile.Arguments>
                            </InvokeWorkflowFile>
                            <Assign sap2010:WorkflowViewState.IdRef="Assign_DBEscInc">
                              <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Escalated]</OutArgument></Assign.To>
                              <Assign.Value><InArgument x:TypeArguments="x:Int32">[out_Escalated + 1]</InArgument></Assign.Value>
                            </Assign>
                          </Sequence>
                        </If.Then>
                        <If.Else>
                          <Sequence DisplayName="Cancel the later-booked appt" sap2010:WorkflowViewState.IdRef="Seq_DBCancel">
                            <InvokeWorkflowFile DisplayName="POST cancel related"
                              sap2010:WorkflowViewState.IdRef="Invoke_Cancel"
                              WorkflowFileName="..\..\shared\HMS_Client.xaml">
                              <InvokeWorkflowFile.Arguments>
                                <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                                <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                                <InArgument x:TypeArguments="x:String" x:Key="in_Method">["POST"]</InArgument>
                                <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/appointments/" &amp; RelatedApptId.ToString() &amp; "/cancel"]</InArgument>
                                <InArgument x:TypeArguments="x:String" x:Key="in_Body">[&quot;{&quot;&quot;actor&quot;&quot;:&quot;&quot;ConflictResolutionBot&quot;&quot;,&quot;&quot;note&quot;&quot;:&quot;&quot;Resolving DOUBLE_BOOKING; keeper wins&quot;&quot;}&quot;]</InArgument>
                                <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                                <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                                <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                                <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                                <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                              </InvokeWorkflowFile.Arguments>
                            </InvokeWorkflowFile>

                            <If Condition="[StatusCode &gt;= 200 AndAlso StatusCode &lt; 300]"
                              sap2010:WorkflowViewState.IdRef="If_CancelOk">
                              <If.Then>
                                <Sequence sap2010:WorkflowViewState.IdRef="Seq_DBRes">
                                  <InvokeWorkflowFile DisplayName="PATCH resolve DB"
                                    sap2010:WorkflowViewState.IdRef="Invoke_DBRes"
                                    WorkflowFileName="..\..\shared\HMS_Client.xaml">
                                    <InvokeWorkflowFile.Arguments>
                                      <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                                      <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                                      <InArgument x:TypeArguments="x:String" x:Key="in_Method">["PATCH"]</InArgument>
                                      <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/conflicts/" &amp; ConflictId.ToString()]</InArgument>
                                      <InArgument x:TypeArguments="x:String" x:Key="in_Body">[New Newtonsoft.Json.Linq.JObject(New Newtonsoft.Json.Linq.JProperty("status", "RESOLVED"), New Newtonsoft.Json.Linq.JProperty("resolution", "CANCELLED_LOSER"), New Newtonsoft.Json.Linq.JProperty("resolution_note", "Cancelled appointment " &amp; RelatedApptId.ToString())).ToString()]</InArgument>
                                      <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                                      <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                                      <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                                      <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                                      <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                                    </InvokeWorkflowFile.Arguments>
                                  </InvokeWorkflowFile>
                                  <Assign sap2010:WorkflowViewState.IdRef="Assign_DBResInc">
                                    <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Resolved]</OutArgument></Assign.To>
                                    <Assign.Value><InArgument x:TypeArguments="x:Int32">[out_Resolved + 1]</InArgument></Assign.Value>
                                  </Assign>
                                </Sequence>
                              </If.Then>
                              <If.Else>
                                <Sequence sap2010:WorkflowViewState.IdRef="Seq_DBEscFail">
                                  <InvokeWorkflowFile DisplayName="PATCH escalate DB fail"
                                    sap2010:WorkflowViewState.IdRef="Invoke_DBEscFail"
                                    WorkflowFileName="..\..\shared\HMS_Client.xaml">
                                    <InvokeWorkflowFile.Arguments>
                                      <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                                      <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                                      <InArgument x:TypeArguments="x:String" x:Key="in_Method">["PATCH"]</InArgument>
                                      <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/conflicts/" &amp; ConflictId.ToString()]</InArgument>
                                      <InArgument x:TypeArguments="x:String" x:Key="in_Body">[New Newtonsoft.Json.Linq.JObject(New Newtonsoft.Json.Linq.JProperty("status", "ESCALATED"), New Newtonsoft.Json.Linq.JProperty("resolution", "CANCEL_FAILED"), New Newtonsoft.Json.Linq.JProperty("resolution_note", "Cancel failed: " &amp; ErrorCode)).ToString()]</InArgument>
                                      <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                                      <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                                      <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                                      <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                                      <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                                    </InvokeWorkflowFile.Arguments>
                                  </InvokeWorkflowFile>
                                  <Assign sap2010:WorkflowViewState.IdRef="Assign_DBFailInc">
                                    <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Escalated]</OutArgument></Assign.To>
                                    <Assign.Value><InArgument x:TypeArguments="x:Int32">[out_Escalated + 1]</InArgument></Assign.Value>
                                  </Assign>
                                </Sequence>
                              </If.Else>
                            </If>
                          </Sequence>
                        </If.Else>
                      </If>
                    </Sequence>

                    <!-- CANCELLATION_CASCADE: no action needed — cancel already freed the slot -->
                    <Sequence x:Key="CANCELLATION_CASCADE" sap2010:WorkflowViewState.IdRef="Seq_CC">
                      <InvokeWorkflowFile DisplayName="PATCH resolve cascade"
                        sap2010:WorkflowViewState.IdRef="Invoke_CCRes"
                        WorkflowFileName="..\..\shared\HMS_Client.xaml">
                        <InvokeWorkflowFile.Arguments>
                          <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                          <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Method">["PATCH"]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/conflicts/" &amp; ConflictId.ToString()]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Body">[&quot;{&quot;&quot;status&quot;&quot;:&quot;&quot;RESOLVED&quot;&quot;,&quot;&quot;resolution&quot;&quot;:&quot;&quot;NO_ACTION_REQUIRED&quot;&quot;,&quot;&quot;resolution_note&quot;&quot;:&quot;&quot;Cancel freed slot for backfill&quot;&quot;}&quot;]</InArgument>
                          <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                          <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                          <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                          <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                          <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                        </InvokeWorkflowFile.Arguments>
                      </InvokeWorkflowFile>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_CCInc">
                        <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Resolved]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Int32">[out_Resolved + 1]</InArgument></Assign.Value>
                      </Assign>
                    </Sequence>

                    <!-- DOCTOR_UNAVAILABLE: escalate — needs clerk to reassign patients (safety rail: URGENT never auto-moved) -->
                    <Sequence x:Key="DOCTOR_UNAVAILABLE" sap2010:WorkflowViewState.IdRef="Seq_DU">
                      <InvokeWorkflowFile DisplayName="PATCH escalate absence"
                        sap2010:WorkflowViewState.IdRef="Invoke_DUEsc"
                        WorkflowFileName="..\..\shared\HMS_Client.xaml">
                        <InvokeWorkflowFile.Arguments>
                          <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                          <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Method">["PATCH"]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/conflicts/" &amp; ConflictId.ToString()]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Body">[&quot;{&quot;&quot;status&quot;&quot;:&quot;&quot;ESCALATED&quot;&quot;,&quot;&quot;resolution&quot;&quot;:&quot;&quot;NEEDS_CLERK&quot;&quot;,&quot;&quot;resolution_note&quot;&quot;:&quot;&quot;Doctor absence: safety rails require clerk-driven rescheduling&quot;&quot;}&quot;]</InArgument>
                          <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                          <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                          <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                          <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                          <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                        </InvokeWorkflowFile.Arguments>
                      </InvokeWorkflowFile>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_DUInc">
                        <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Escalated]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Int32">[out_Escalated + 1]</InArgument></Assign.Value>
                      </Assign>
                    </Sequence>

                    <!-- EXCEL_MISMATCH: escalate — human runs excel_mirror.py reconcile -->
                    <Sequence x:Key="EXCEL_MISMATCH" sap2010:WorkflowViewState.IdRef="Seq_EM">
                      <InvokeWorkflowFile DisplayName="PATCH escalate excel"
                        sap2010:WorkflowViewState.IdRef="Invoke_EMEsc"
                        WorkflowFileName="..\..\shared\HMS_Client.xaml">
                        <InvokeWorkflowFile.Arguments>
                          <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                          <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Method">["PATCH"]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Path">["/conflicts/" &amp; ConflictId.ToString()]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_Body">[&quot;{&quot;&quot;status&quot;&quot;:&quot;&quot;ESCALATED&quot;&quot;,&quot;&quot;resolution&quot;&quot;:&quot;&quot;NEEDS_RECONCILE&quot;&quot;,&quot;&quot;resolution_note&quot;&quot;:&quot;&quot;Run tools/excel_mirror.py reconcile&quot;&quot;}&quot;]</InArgument>
                          <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[2]</InArgument>
                          <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[StatusCode]</OutArgument>
                          <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[ResponseJson]</OutArgument>
                          <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[ErrorCode]</OutArgument>
                          <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[Retryable]</OutArgument>
                        </InvokeWorkflowFile.Arguments>
                      </InvokeWorkflowFile>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_EMInc">
                        <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_Escalated]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Int32">[out_Escalated + 1]</InArgument></Assign.Value>
                      </Assign>
                    </Sequence>
                  </Switch>
                </TryCatch.Try>
                <TryCatch.Catches>
                  <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_One">
                    <ActivityAction x:TypeArguments="s:Exception">
                      <ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="ex" /></ActivityAction.Argument>
                      <ui:LogMessage Level="Error"
                        Message="[&quot;Conflict &quot; &amp; ConflictId.ToString() &amp; &quot; failed: &quot; &amp; ex.Message]"
                        sap2010:WorkflowViewState.IdRef="Log_ResFail" />
                    </ActivityAction>
                  </Catch>
                </TryCatch.Catches>
              </TryCatch>

              <Assign sap2010:WorkflowViewState.IdRef="Assign_NextIdxC">
                <Assign.To><OutArgument x:TypeArguments="x:Int32">[Idx]</OutArgument></Assign.To>
                <Assign.Value><InArgument x:TypeArguments="x:Int32">[Idx + 1]</InArgument></Assign.Value>
              </Assign>
            </Sequence>
          </While>
        </Sequence>
      </If.Else>
    </If>

    <ui:LogMessage DisplayName="Log finished" Level="Info"
      Message="[&quot;ConflictBot finished. Detected=&quot; &amp; out_Detected.ToString() &amp; &quot; Resolved=&quot; &amp; out_Resolved.ToString() &amp; &quot; Escalated=&quot; &amp; out_Escalated.ToString()]"
      sap2010:WorkflowViewState.IdRef="Log_End" />
  </Sequence>
</Activity>
