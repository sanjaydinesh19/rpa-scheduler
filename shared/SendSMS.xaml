<Activity mc:Ignorable="sap sap2010" x:Class="SendSMS"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:uwa="clr-namespace:UiPath.Web.Activities;assembly=UiPath.Web.Activities"
 xmlns:jl="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_To" Type="InArgument(x:String)" />
    <x:Property Name="in_Body" Type="InArgument(x:String)" />
    <x:Property Name="in_AccountSid" Type="InArgument(x:String)" />
    <x:Property Name="in_AuthToken" Type="InArgument(s:Security.SecureString)" />
    <x:Property Name="in_FromNumber" Type="InArgument(x:String)" />
    <x:Property Name="in_DryRun" Type="InArgument(x:Boolean)" />
    <x:Property Name="out_Success" Type="OutArgument(x:Boolean)" />
    <x:Property Name="out_MessageId" Type="OutArgument(x:String)" />
    <x:Property Name="out_ErrorCode" Type="OutArgument(x:String)" />
    <x:Property Name="out_Retryable" Type="OutArgument(x:Boolean)" />
  </x:Members>
  <sap2010:ExpressionActivityEditor.ExpressionActivityEditor>VisualBasic</sap2010:ExpressionActivityEditor.ExpressionActivityEditor>
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="8">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Text.RegularExpressions</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>Newtonsoft.Json.Linq</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference" Capacity="8">
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Text.RegularExpressions</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Web.Activities</AssemblyReference>
      <AssemblyReference>Newtonsoft.Json</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>

  <Sequence DisplayName="Send SMS via Twilio" sap2010:WorkflowViewState.IdRef="Seq_Root">
    <sap2010:Annotation.AnnotationText>shared/SendSMS.xaml — Twilio wrapper used by all three bots.

Dry run:  the whole pipeline still runs, provider = DRYRUN, no credits spent.
Live:     POST to /2010-04-01/Accounts/{sid}/Messages.json with Basic auth and
          application/x-www-form-urlencoded body. E.164 To is enforced before
          the call.</sap2010:Annotation.AnnotationText>
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="AuthTokenPlain" />
      <Variable x:TypeArguments="x:String" Name="Endpoint" />
      <Variable x:TypeArguments="x:String" Name="BodyForm" />
      <Variable x:TypeArguments="x:String" Name="BasicAuth" />
      <Variable x:TypeArguments="x:Int32" Name="StatusCode" />
      <Variable x:TypeArguments="x:String" Name="Response" />
      <Variable x:TypeArguments="jl:JObject" Name="J" />
      <Variable x:TypeArguments="x:Boolean" Name="Exit" Default="[False]" />
    </Sequence.Variables>

    <Assign DisplayName="Default outputs" sap2010:WorkflowViewState.IdRef="Assign_Defaults">
      <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_Success]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
    </Assign>

    <If DisplayName="Validate E.164"
      Condition="[String.IsNullOrEmpty(in_To) OrElse Not Regex.IsMatch(in_To, &quot;^\+[1-9]\d{9,14}$&quot;)]"
      sap2010:WorkflowViewState.IdRef="If_E164">
      <If.Then>
        <Sequence sap2010:WorkflowViewState.IdRef="Seq_BadNumber">
          <Assign sap2010:WorkflowViewState.IdRef="Assign_BadCode">
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_ErrorCode]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["INVALID_CONTACT"]</InArgument></Assign.Value>
          </Assign>
          <Assign sap2010:WorkflowViewState.IdRef="Assign_BadRetry">
            <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_Retryable]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
          </Assign>
          <Assign sap2010:WorkflowViewState.IdRef="Assign_BadExit">
            <Assign.To><OutArgument x:TypeArguments="x:Boolean">[Exit]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
    </If>

    <If DisplayName="Dry run branch" Condition="[Not Exit AndAlso in_DryRun]"
      sap2010:WorkflowViewState.IdRef="If_Dry">
      <If.Then>
        <Sequence sap2010:WorkflowViewState.IdRef="Seq_Dry">
          <Assign sap2010:WorkflowViewState.IdRef="Assign_Dry_Id">
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_MessageId]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["DRYRUN-" &amp; Guid.NewGuid().ToString("N").Substring(0, 12)]</InArgument></Assign.Value>
          </Assign>
          <Assign sap2010:WorkflowViewState.IdRef="Assign_Dry_Ok">
            <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_Success]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
          </Assign>
          <ui:LogMessage DisplayName="Log dry-run" Level="Info"
            Message="[&quot;SMS DRYRUN to &quot; &amp; in_To.Substring(0, Math.Min(5, in_To.Length)) &amp; &quot;****&quot; &amp; in_To.Substring(Math.Max(0, in_To.Length - 4)) &amp; &quot; len=&quot; &amp; in_Body.Length.ToString()]"
            sap2010:WorkflowViewState.IdRef="Log_Dry" />
          <Assign sap2010:WorkflowViewState.IdRef="Assign_Dry_Exit">
            <Assign.To><OutArgument x:TypeArguments="x:Boolean">[Exit]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
    </If>

    <If DisplayName="Live send" Condition="[Not Exit]" sap2010:WorkflowViewState.IdRef="If_Live">
      <If.Then>
        <Sequence sap2010:WorkflowViewState.IdRef="Seq_Live">
          <Assign sap2010:WorkflowViewState.IdRef="Assign_Token">
            <Assign.To><OutArgument x:TypeArguments="x:String">[AuthTokenPlain]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">[New System.Net.NetworkCredential(String.Empty, in_AuthToken).Password]</InArgument></Assign.Value>
          </Assign>

          <Assign sap2010:WorkflowViewState.IdRef="Assign_Endpoint">
            <Assign.To><OutArgument x:TypeArguments="x:String">[Endpoint]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["https://api.twilio.com/2010-04-01/Accounts/" &amp; in_AccountSid &amp; "/Messages.json"]</InArgument></Assign.Value>
          </Assign>

          <Assign sap2010:WorkflowViewState.IdRef="Assign_Basic">
            <Assign.To><OutArgument x:TypeArguments="x:String">[BasicAuth]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["Basic " &amp; Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(in_AccountSid &amp; ":" &amp; AuthTokenPlain))]</InArgument></Assign.Value>
          </Assign>

          <Assign sap2010:WorkflowViewState.IdRef="Assign_Body">
            <Assign.To><OutArgument x:TypeArguments="x:String">[BodyForm]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["To=" &amp; System.Net.WebUtility.UrlEncode(in_To) &amp; "&amp;From=" &amp; System.Net.WebUtility.UrlEncode(in_FromNumber) &amp; "&amp;Body=" &amp; System.Net.WebUtility.UrlEncode(in_Body)]</InArgument></Assign.Value>
          </Assign>

          <TryCatch DisplayName="Call Twilio" sap2010:WorkflowViewState.IdRef="Try_Twilio">
            <TryCatch.Try>
              <Sequence sap2010:WorkflowViewState.IdRef="Seq_Call">
                <uwa:HttpClient DisplayName="POST Messages.json"
                  sap2010:WorkflowViewState.IdRef="Http_Twilio"
                  EndPoint="[Endpoint]"
                  Method="POST"
                  Body="[BodyForm]"
                  BodyFormat="application/x-www-form-urlencoded"
                  ContinueOnError="True"
                  Result="[Response]"
                  StatusCode="[StatusCode]"
                  TimeoutMS="30000">
                  <uwa:HttpClient.Headers>
                    <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[New Dictionary(Of String, String) From {{"Authorization", BasicAuth}, {"Accept", "application/json"}}]</InArgument>
                  </uwa:HttpClient.Headers>
                </uwa:HttpClient>

                <If Condition="[StatusCode = 201 OrElse StatusCode = 200]"
                  sap2010:WorkflowViewState.IdRef="If_Twilio_Ok">
                  <If.Then>
                    <Sequence sap2010:WorkflowViewState.IdRef="Seq_Twilio_Ok">
                      <ui:DeserializeJson JsonObject="[J]" JsonString="[Response]"
                        sap2010:WorkflowViewState.IdRef="Deser_Ok" />
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_Sid">
                        <Assign.To><OutArgument x:TypeArguments="x:String">[out_MessageId]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:String">[If(J("sid") Is Nothing, "", J("sid").ToString())]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_Ok_Bool">
                        <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_Success]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Then>
                  <If.Else>
                    <Sequence sap2010:WorkflowViewState.IdRef="Seq_Twilio_Err">
                      <ui:DeserializeJson JsonObject="[J]"
                        JsonString="[If(String.IsNullOrWhiteSpace(Response), &quot;{}&quot;, Response)]"
                        sap2010:WorkflowViewState.IdRef="Deser_Err" />
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_Twilio_Code">
                        <Assign.To><OutArgument x:TypeArguments="x:String">[out_ErrorCode]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:String">[If(J("code") IsNot Nothing, "TWILIO_" &amp; J("code").ToString(), "TWILIO_HTTP_" &amp; StatusCode.ToString())]</InArgument></Assign.Value>
                      </Assign>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_Twilio_Retry">
                        <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_Retryable]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Boolean">[StatusCode = 429 OrElse StatusCode &gt;= 500]</InArgument></Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Else>
                </If>
              </Sequence>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_Twilio">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="ex" /></ActivityAction.Argument>
                  <Sequence sap2010:WorkflowViewState.IdRef="Seq_Catch_Twilio">
                    <Assign sap2010:WorkflowViewState.IdRef="Assign_Catch_Code">
                      <Assign.To><OutArgument x:TypeArguments="x:String">[out_ErrorCode]</OutArgument></Assign.To>
                      <Assign.Value><InArgument x:TypeArguments="x:String">["NETWORK_TIMEOUT"]</InArgument></Assign.Value>
                    </Assign>
                    <Assign sap2010:WorkflowViewState.IdRef="Assign_Catch_Retry">
                      <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_Retryable]</OutArgument></Assign.To>
                      <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
                    </Assign>
                  </Sequence>
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
        </Sequence>
      </If.Then>
    </If>

    <ui:LogMessage DisplayName="Log masked result" Level="Info"
      Message="[&quot;SMS to &quot; &amp; If(in_To.Length &gt;= 9, in_To.Substring(0, 5) &amp; &quot;****&quot; &amp; in_To.Substring(in_To.Length - 4), in_To) &amp; &quot; success=&quot; &amp; out_Success.ToString() &amp; &quot; err=&quot; &amp; out_ErrorCode]"
      sap2010:WorkflowViewState.IdRef="Log_Done" />
  </Sequence>
</Activity>
