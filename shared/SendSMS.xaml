<Activity mc:Ignorable="sap sap2010" x:Class="SendSMS"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_To" Type="InArgument(x:String)" />
    <x:Property Name="in_Body" Type="InArgument(x:String)" />
    <x:Property Name="in_AccountSid" Type="InArgument(x:String)" />
    <x:Property Name="in_AuthToken" Type="InArgument(s:Security.SecureString)" />
    <x:Property Name="in_FromNumber" Type="InArgument(x:String)" />
    <x:Property Name="in_DryRun" Type="InArgument(x:Boolean)" />
    <x:Property Name="out_Success" Type="OutArgument(x:Boolean)" />
    <x:Property Name="out_MessageId" Type="OutArgument(x:String)" />
    <x:Property Name="out_ErrorCode" Type="OutArgument(x:String)" />
    <x:Property Name="out_Retryable" Type="OutArgument(x:Boolean)" />
  </x:Members>
  <sap2010:ExpressionActivityEditor.ExpressionActivityEditor>VisualBasic</sap2010:ExpressionActivityEditor.ExpressionActivityEditor>
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="8">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Net.Http</x:String>
      <x:String>System.Text.RegularExpressions</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>Newtonsoft.Json.Linq</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference" Capacity="8">
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Net.Http</AssemblyReference>
      <AssemblyReference>System.Text.RegularExpressions</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>Newtonsoft.Json</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>

  <Sequence DisplayName="Send SMS via Twilio" sap2010:WorkflowViewState.IdRef="Seq_Root">
    <sap2010:Annotation.AnnotationText>shared/SendSMS.xaml — Twilio wrapper. Uses System.Net.Http.HttpClient via
InvokeCode so it doesn't depend on the UiPath HTTP Request activity's
version-sensitive Method / Headers types.

Dry run: whole pipeline still runs, provider = DRYRUN, no credits.
Live:    POST to /2010-04-01/Accounts/{sid}/Messages.json with Basic auth and
         application/x-www-form-urlencoded body. E.164 To enforced first.</sap2010:Annotation.AnnotationText>

    <ui:InvokeCode DisplayName="Twilio send"
      sap2010:WorkflowViewState.IdRef="InvokeCode_Twilio"
      Language="VBNet"
      Code="out_Success = False
out_MessageId = &quot;&quot;
out_ErrorCode = &quot;&quot;
out_Retryable = False

' Guard: E.164
If String.IsNullOrEmpty(in_To) OrElse Not System.Text.RegularExpressions.Regex.IsMatch(in_To, &quot;^\+[1-9]\d{9,14}$&quot;) Then
    out_ErrorCode = &quot;INVALID_CONTACT&quot;
    Return
End If

' Dry run
If in_DryRun Then
    out_MessageId = &quot;DRYRUN-&quot; &amp; Guid.NewGuid().ToString(&quot;N&quot;).Substring(0, 12)
    out_Success = True
    Return
End If

Try
    Dim tokenPlain As String = New System.Net.NetworkCredential(String.Empty, in_AuthToken).Password
    Dim endpoint As String = &quot;https://api.twilio.com/2010-04-01/Accounts/&quot; &amp; in_AccountSid &amp; &quot;/Messages.json&quot;
    Dim basic As String = &quot;Basic &quot; &amp; Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(in_AccountSid &amp; &quot;:&quot; &amp; tokenPlain))
    Dim form As String = &quot;To=&quot; &amp; System.Net.WebUtility.UrlEncode(in_To) &amp; &quot;&amp;From=&quot; &amp; System.Net.WebUtility.UrlEncode(in_FromNumber) &amp; &quot;&amp;Body=&quot; &amp; System.Net.WebUtility.UrlEncode(in_Body)

    Dim client As New System.Net.Http.HttpClient()
    client.Timeout = TimeSpan.FromSeconds(30)
    Dim req As New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, endpoint)
    req.Headers.TryAddWithoutValidation(&quot;Authorization&quot;, basic)
    req.Headers.TryAddWithoutValidation(&quot;Accept&quot;, &quot;application/json&quot;)
    req.Content = New System.Net.Http.StringContent(form, System.Text.Encoding.UTF8, &quot;application/x-www-form-urlencoded&quot;)

    Dim resp As System.Net.Http.HttpResponseMessage = client.SendAsync(req).GetAwaiter().GetResult()
    Dim status As Integer = CInt(resp.StatusCode)
    Dim body As String = resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()
    client.Dispose()

    If status = 200 OrElse status = 201 Then
        Try
            Dim j As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(body)
            out_MessageId = If(j(&quot;sid&quot;) Is Nothing, &quot;&quot;, j(&quot;sid&quot;).ToString())
        Catch
            out_MessageId = &quot;&quot;
        End Try
        out_Success = True
    Else
        Try
            Dim j As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(If(String.IsNullOrWhiteSpace(body), &quot;{}&quot;, body))
            out_ErrorCode = If(j(&quot;code&quot;) IsNot Nothing, &quot;TWILIO_&quot; &amp; j(&quot;code&quot;).ToString(), &quot;TWILIO_HTTP_&quot; &amp; status.ToString())
        Catch
            out_ErrorCode = &quot;TWILIO_HTTP_&quot; &amp; status.ToString()
        End Try
        out_Retryable = (status = 429) OrElse (status &gt;= 500)
    End If
Catch ex As Exception
    out_ErrorCode = &quot;NETWORK_TIMEOUT&quot;
    out_Retryable = True
End Try">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="in_To">[in_To]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_Body">[in_Body]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_AccountSid">[in_AccountSid]</InArgument>
        <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_AuthToken">[in_AuthToken]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_FromNumber">[in_FromNumber]</InArgument>
        <InArgument x:TypeArguments="x:Boolean" x:Key="in_DryRun">[in_DryRun]</InArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[out_Success]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_MessageId">[out_MessageId]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[out_ErrorCode]</OutArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[out_Retryable]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>

    <ui:LogMessage DisplayName="Log masked result" Level="Info"
      Message="[&quot;SMS to &quot; &amp; If(in_To.Length &gt;= 9, in_To.Substring(0, 5) &amp; &quot;****&quot; &amp; in_To.Substring(in_To.Length - 4), in_To) &amp; &quot; success=&quot; &amp; out_Success.ToString() &amp; &quot; err=&quot; &amp; out_ErrorCode]"
      sap2010:WorkflowViewState.IdRef="Log_Done" />
  </Sequence>
</Activity>
