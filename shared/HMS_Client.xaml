<Activity mc:Ignorable="sap sap2010" x:Class="HMS_Client"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:uwa="clr-namespace:UiPath.Web.Activities;assembly=UiPath.Web.Activities"
 xmlns:jl="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_BaseUrl" Type="InArgument(x:String)" />
    <x:Property Name="in_ApiKey" Type="InArgument(s:Security.SecureString)" />
    <x:Property Name="in_Method" Type="InArgument(x:String)" />
    <x:Property Name="in_Path" Type="InArgument(x:String)" />
    <x:Property Name="in_Body" Type="InArgument(x:String)" />
    <x:Property Name="in_MaxAttempts" Type="InArgument(x:Int32)" />
    <x:Property Name="out_StatusCode" Type="OutArgument(x:Int32)" />
    <x:Property Name="out_ResponseJson" Type="OutArgument(x:String)" />
    <x:Property Name="out_ErrorCode" Type="OutArgument(x:String)" />
    <x:Property Name="out_Retryable" Type="OutArgument(x:Boolean)" />
  </x:Members>
  <sap2010:ExpressionActivityEditor.ExpressionActivityEditor>VisualBasic</sap2010:ExpressionActivityEditor.ExpressionActivityEditor>
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="8">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>Newtonsoft.Json.Linq</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference" Capacity="8">
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Web.Activities</AssemblyReference>
      <AssemblyReference>Newtonsoft.Json</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>

  <Sequence DisplayName="HMS Client" sap2010:WorkflowViewState.IdRef="Seq_Root">
    <sap2010:Annotation.AnnotationText>shared/HMS_Client.xaml — one wrapper for every REST call to the Mock HMS.

Every HMS API call from every bot goes through this workflow so auth, retry
and error handling are written exactly once.

Retry policy:
  2xx                        success
  retryable = true           wait 2^n seconds and retry, up to in_MaxAttempts
  SLOT_TAKEN / SLOT_LOCKED   retryable, but return immediately (caller picks another slot)
  retryable = false          return at once with out_ErrorCode set
  401 UNAUTHORIZED           system exception — asset is wrong, every call fails the same way
  timeout / socket           counts as retryable</sap2010:Annotation.AnnotationText>
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="AttemptNo" Default="[1]" />
      <Variable x:TypeArguments="x:String" Name="Url" />
      <Variable x:TypeArguments="x:String" Name="ApiKeyPlain" />
      <Variable x:TypeArguments="x:Boolean" Name="Done" Default="[False]" />
      <Variable x:TypeArguments="jl:JObject" Name="JErr" />
      <Variable x:TypeArguments="x:Int32" Name="Backoff" Default="[2]" />
    </Sequence.Variables>

    <ui:LogMessage DisplayName="Log start" Level="Trace"
      Message="[&quot;HMS_Client &quot; &amp; in_Method &amp; &quot; &quot; &amp; in_Path]"
      sap2010:WorkflowViewState.IdRef="Log_Start" />

    <Assign DisplayName="Build URL" sap2010:WorkflowViewState.IdRef="Assign_Url">
      <Assign.To><OutArgument x:TypeArguments="x:String">[Url]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[in_BaseUrl.TrimEnd("/"c) &amp; "/api/v1" &amp; in_Path]</InArgument></Assign.Value>
    </Assign>

    <Assign DisplayName="SecureString to plain" sap2010:WorkflowViewState.IdRef="Assign_Key">
      <Assign.To><OutArgument x:TypeArguments="x:String">[ApiKeyPlain]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[New System.Net.NetworkCredential(String.Empty, in_ApiKey).Password]</InArgument></Assign.Value>
    </Assign>

    <Assign DisplayName="Default outputs" sap2010:WorkflowViewState.IdRef="Assign_Defaults">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_ErrorCode]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[""]</InArgument></Assign.Value>
    </Assign>

    <While DisplayName="Retry loop"
      Condition="[Not Done AndAlso AttemptNo &lt;= in_MaxAttempts]"
      sap2010:WorkflowViewState.IdRef="While_Retry">
      <TryCatch DisplayName="Attempt" sap2010:WorkflowViewState.IdRef="Try_Attempt">
        <TryCatch.Try>
          <Sequence DisplayName="Do call" sap2010:WorkflowViewState.IdRef="Seq_Do">
            <uwa:HttpClient DisplayName="HTTP Request"
              sap2010:WorkflowViewState.IdRef="Http_1"
              EndPoint="[Url]"
              Body="[in_Body]"
              BodyFormat="application/json"
              ContinueOnError="True"
              Result="[out_ResponseJson]"
              StatusCode="[out_StatusCode]"
              TimeoutMS="30000">
              <uwa:HttpClient.Method>
                <InArgument x:TypeArguments="uwa:HttpMethod">[CType(System.Enum.Parse(GetType(UiPath.Web.Activities.HttpMethod), in_Method, True), UiPath.Web.Activities.HttpMethod)]</InArgument>
              </uwa:HttpClient.Method>
              <uwa:HttpClient.Headers>
                <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[New Dictionary(Of String, String) From {{"X-API-Key", ApiKeyPlain}, {"Accept", "application/json"}}]</InArgument>
              </uwa:HttpClient.Headers>
            </uwa:HttpClient>

            <If DisplayName="Success?" Condition="[out_StatusCode &gt;= 200 AndAlso out_StatusCode &lt; 300]"
              sap2010:WorkflowViewState.IdRef="If_Ok">
              <If.Then>
                <Sequence sap2010:WorkflowViewState.IdRef="Seq_Ok">
                  <Assign sap2010:WorkflowViewState.IdRef="Assign_Ok_Err">
                    <Assign.To><OutArgument x:TypeArguments="x:String">[out_ErrorCode]</OutArgument></Assign.To>
                    <Assign.Value><InArgument x:TypeArguments="x:String">[""]</InArgument></Assign.Value>
                  </Assign>
                  <Assign sap2010:WorkflowViewState.IdRef="Assign_Ok_Retry">
                    <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_Retryable]</OutArgument></Assign.To>
                    <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
                  </Assign>
                  <Assign sap2010:WorkflowViewState.IdRef="Assign_Ok_Done">
                    <Assign.To><OutArgument x:TypeArguments="x:Boolean">[Done]</OutArgument></Assign.To>
                    <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
                  </Assign>
                </Sequence>
              </If.Then>
              <If.Else>
                <Sequence sap2010:WorkflowViewState.IdRef="Seq_Err">
                  <If DisplayName="401 auth failure?" Condition="[out_StatusCode = 401]"
                    sap2010:WorkflowViewState.IdRef="If_401">
                    <If.Then>
                      <Throw DisplayName="Throw system exception"
                        Exception="[New System.InvalidOperationException(&quot;HMS returned 401 UNAUTHORIZED — check HMS_ApiKey asset&quot;)]"
                        sap2010:WorkflowViewState.IdRef="Throw_401" />
                    </If.Then>
                  </If>

                  <ui:DeserializeJson DisplayName="Parse error envelope"
                    JsonObject="[JErr]"
                    JsonString="[If(String.IsNullOrWhiteSpace(out_ResponseJson), &quot;{}&quot;, out_ResponseJson)]"
                    sap2010:WorkflowViewState.IdRef="Deser_Err" />

                  <Assign sap2010:WorkflowViewState.IdRef="Assign_Err_Code">
                    <Assign.To><OutArgument x:TypeArguments="x:String">[out_ErrorCode]</OutArgument></Assign.To>
                    <Assign.Value><InArgument x:TypeArguments="x:String">[If(JErr Is Nothing OrElse JErr("error_code") Is Nothing, "HTTP_" &amp; out_StatusCode.ToString(), JErr("error_code").ToString())]</InArgument></Assign.Value>
                  </Assign>

                  <Assign sap2010:WorkflowViewState.IdRef="Assign_Err_Retry">
                    <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_Retryable]</OutArgument></Assign.To>
                    <Assign.Value><InArgument x:TypeArguments="x:Boolean">[JErr IsNot Nothing AndAlso JErr("retryable") IsNot Nothing AndAlso Boolean.Parse(JErr("retryable").ToString())]</InArgument></Assign.Value>
                  </Assign>

                  <If DisplayName="Retry?" Condition="[out_Retryable AndAlso out_ErrorCode &lt;&gt; &quot;SLOT_TAKEN&quot; AndAlso out_ErrorCode &lt;&gt; &quot;SLOT_LOCKED&quot; AndAlso AttemptNo &lt; in_MaxAttempts]"
                    sap2010:WorkflowViewState.IdRef="If_Retry">
                    <If.Then>
                      <Sequence sap2010:WorkflowViewState.IdRef="Seq_Retry">
                        <ui:LogMessage DisplayName="Log retry" Level="Warn"
                          Message="[&quot;HMS &quot; &amp; out_ErrorCode &amp; &quot; on attempt &quot; &amp; AttemptNo.ToString() &amp; &quot;, backing off &quot; &amp; Backoff.ToString() &amp; &quot;s&quot;]"
                          sap2010:WorkflowViewState.IdRef="Log_Retry" />
                        <ui:Delay Duration="[TimeSpan.FromSeconds(Backoff)]"
                          sap2010:WorkflowViewState.IdRef="Delay_Backoff" />
                        <Assign sap2010:WorkflowViewState.IdRef="Assign_Backoff">
                          <Assign.To><OutArgument x:TypeArguments="x:Int32">[Backoff]</OutArgument></Assign.To>
                          <Assign.Value><InArgument x:TypeArguments="x:Int32">[Backoff * 2]</InArgument></Assign.Value>
                        </Assign>
                      </Sequence>
                    </If.Then>
                    <If.Else>
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_NoRetry_Done">
                        <Assign.To><OutArgument x:TypeArguments="x:Boolean">[Done]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
                      </Assign>
                    </If.Else>
                  </If>
                </Sequence>
              </If.Else>
            </If>
          </Sequence>
        </TryCatch.Try>
        <TryCatch.Catches>
          <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_Net">
            <ActivityAction x:TypeArguments="s:Exception">
              <ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="ex" /></ActivityAction.Argument>
              <Sequence sap2010:WorkflowViewState.IdRef="Seq_NetErr">
                <ui:LogMessage DisplayName="Log network error" Level="Warn"
                  Message="[&quot;HMS network failure on attempt &quot; &amp; AttemptNo.ToString() &amp; &quot;: &quot; &amp; ex.Message]"
                  sap2010:WorkflowViewState.IdRef="Log_Net" />
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Net_Code">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[out_ErrorCode]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">["NETWORK_TIMEOUT"]</InArgument></Assign.Value>
                </Assign>
                <Assign sap2010:WorkflowViewState.IdRef="Assign_Net_Retry">
                  <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_Retryable]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
                </Assign>
                <If Condition="[AttemptNo &gt;= in_MaxAttempts]"
                  sap2010:WorkflowViewState.IdRef="If_Net_LastAttempt">
                  <If.Then>
                    <Assign sap2010:WorkflowViewState.IdRef="Assign_Net_Done">
                      <Assign.To><OutArgument x:TypeArguments="x:Boolean">[Done]</OutArgument></Assign.To>
                      <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
                    </Assign>
                  </If.Then>
                  <If.Else>
                    <Sequence sap2010:WorkflowViewState.IdRef="Seq_Net_Wait">
                      <ui:Delay Duration="[TimeSpan.FromSeconds(Backoff)]"
                        sap2010:WorkflowViewState.IdRef="Delay_Net" />
                      <Assign sap2010:WorkflowViewState.IdRef="Assign_Net_Backoff">
                        <Assign.To><OutArgument x:TypeArguments="x:Int32">[Backoff]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Int32">[Backoff * 2]</InArgument></Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Else>
                </If>
              </Sequence>
            </ActivityAction>
          </Catch>
        </TryCatch.Catches>
      </TryCatch>

      <Assign DisplayName="Increment attempt" sap2010:WorkflowViewState.IdRef="Assign_NextAttempt">
        <Assign.To><OutArgument x:TypeArguments="x:Int32">[AttemptNo]</OutArgument></Assign.To>
        <Assign.Value><InArgument x:TypeArguments="x:Int32">[AttemptNo + 1]</InArgument></Assign.Value>
      </Assign>
    </While>

    <ui:LogMessage DisplayName="Log done" Level="Trace"
      Message="[&quot;HMS_Client done: status=&quot; &amp; out_StatusCode.ToString() &amp; &quot; err=&quot; &amp; out_ErrorCode]"
      sap2010:WorkflowViewState.IdRef="Log_Done" />
  </Sequence>
</Activity>
