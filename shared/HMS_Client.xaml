 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_BaseUrl" Type="InArgument(x:String)" />
    <x:Property Name="in_ApiKey" Type="InArgument(s:Security.SecureString)" />
    <x:Property Name="in_Method" Type="InArgument(x:String)" />
    <x:Property Name="in_Path" Type="InArgument(x:String)" />
    <x:Property Name="in_Body" Type="InArgument(x:String)" />
    <x:Property Name="in_MaxAttempts" Type="InArgument(x:Int32)" />
    <x:Property Name="out_StatusCode" Type="OutArgument(x:Int32)" />
    <x:Property Name="out_ResponseJson" Type="OutArgument(x:String)" />
    <x:Property Name="out_ErrorCode" Type="OutArgument(x:String)" />
    <x:Property Name="out_Retryable" Type="OutArgument(x:Boolean)" />
  </x:Members>
  <sap2010:ExpressionActivityEditor.ExpressionActivityEditor>VisualBasic</sap2010:ExpressionActivityEditor.ExpressionActivityEditor>
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="8">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Net.Http</x:String>
      <x:String>System.Threading</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>Newtonsoft.Json.Linq</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference" Capacity="8">
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Net.Http</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>Newtonsoft.Json</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>

  <Sequence DisplayName="HMS Client" sap2010:WorkflowViewState.IdRef="Seq_Root">
    <sap2010:Annotation.AnnotationText>shared/HMS_Client.xaml — one wrapper for every REST call to the Mock HMS.

Auth, retry and error handling live in a single InvokeCode block that uses
System.Net.Http.HttpClient directly. That sidesteps Studio 26's activity-pack
quirks around the HTTP Request activity's Method and Headers types.

Retry policy:
  2xx                        success
  retryable = true           wait 2^n seconds and retry, up to in_MaxAttempts
  SLOT_TAKEN / SLOT_LOCKED   retryable, but return immediately (caller picks another slot)
  retryable = false          return at once with out_ErrorCode set
  401 UNAUTHORIZED           system exception — asset is wrong, every call fails the same way
  timeout / socket           counts as retryable</sap2010:Annotation.AnnotationText>

    <ui:LogMessage DisplayName="Log start" Level="Trace"
      Message="[&quot;HMS_Client &quot; &amp; in_Method &amp; &quot; &quot; &amp; in_Path]"
      sap2010:WorkflowViewState.IdRef="Log_Start" />

    <ui:InvokeCode DisplayName="Send and retry"
      sap2010:WorkflowViewState.IdRef="InvokeCode_Http"
      Language="VBNet"
      Code="Dim keyPlain As String = New System.Net.NetworkCredential(String.Empty, in_ApiKey).Password
Dim url As String = in_BaseUrl.TrimEnd(&quot;/&quot;c) &amp; &quot;/api/v1&quot; &amp; in_Path
Dim client As New System.Net.Http.HttpClient()
client.Timeout = TimeSpan.FromSeconds(30)

out_ErrorCode = &quot;&quot;
out_Retryable = False
out_StatusCode = 0
out_ResponseJson = &quot;&quot;

Dim attempt As Integer = 1
Dim backoff As Integer = 2
Dim done As Boolean = False

Try
    While Not done AndAlso attempt &lt;= in_MaxAttempts
        Try
            Dim req As New System.Net.Http.HttpRequestMessage(New System.Net.Http.HttpMethod(in_Method.ToUpper()), url)
            req.Headers.TryAddWithoutValidation(&quot;X-API-Key&quot;, keyPlain)
            req.Headers.TryAddWithoutValidation(&quot;Accept&quot;, &quot;application/json&quot;)
            If Not String.IsNullOrEmpty(in_Body) Then
                req.Content = New System.Net.Http.StringContent(in_Body, System.Text.Encoding.UTF8, &quot;application/json&quot;)
            End If

            Dim resp As System.Net.Http.HttpResponseMessage = client.SendAsync(req).GetAwaiter().GetResult()
            out_StatusCode = CInt(resp.StatusCode)
            out_ResponseJson = resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()

            If out_StatusCode &gt;= 200 AndAlso out_StatusCode &lt; 300 Then
                out_ErrorCode = &quot;&quot;
                out_Retryable = False
                done = True
            Else
                If out_StatusCode = 401 Then
                    Throw New System.InvalidOperationException(&quot;HMS 401 UNAUTHORIZED — check HMS_ApiKey asset&quot;)
                End If
                Try
                    Dim j As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(If(String.IsNullOrWhiteSpace(out_ResponseJson), &quot;{}&quot;, out_ResponseJson))
                    out_ErrorCode = If(j(&quot;error_code&quot;) IsNot Nothing, j(&quot;error_code&quot;).ToString(), &quot;HTTP_&quot; &amp; out_StatusCode.ToString())
                    out_Retryable = (j(&quot;retryable&quot;) IsNot Nothing) AndAlso Boolean.Parse(j(&quot;retryable&quot;).ToString())
                Catch
                    out_ErrorCode = &quot;HTTP_&quot; &amp; out_StatusCode.ToString()
                End Try

                If out_Retryable AndAlso out_ErrorCode &lt;&gt; &quot;SLOT_TAKEN&quot; AndAlso out_ErrorCode &lt;&gt; &quot;SLOT_LOCKED&quot; AndAlso attempt &lt; in_MaxAttempts Then
                    System.Threading.Thread.Sleep(backoff * 1000)
                    backoff = backoff * 2
                Else
                    done = True
                End If
            End If
        Catch iex As System.InvalidOperationException
            Throw
        Catch ex As Exception
            out_ErrorCode = &quot;NETWORK_TIMEOUT&quot;
            out_Retryable = True
            If attempt &gt;= in_MaxAttempts Then
                done = True
            Else
                System.Threading.Thread.Sleep(backoff * 1000)
                backoff = backoff * 2
            End If
        End Try
        attempt = attempt + 1
    End While
Finally
    client.Dispose()
End Try">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
        <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_Method">[in_Method]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_Path">[in_Path]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_Body">[in_Body]</InArgument>
        <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[in_MaxAttempts]</InArgument>
        <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[out_StatusCode]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseJson">[out_ResponseJson]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[out_ErrorCode]</OutArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[out_Retryable]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>

    <ui:LogMessage DisplayName="Log done" Level="Trace"
      Message="[&quot;HMS_Client done: status=&quot; &amp; out_StatusCode.ToString() &amp; &quot; err=&quot; &amp; out_ErrorCode]"
      sap2010:WorkflowViewState.IdRef="Log_Done" />
  </Sequence>
</Activity>
