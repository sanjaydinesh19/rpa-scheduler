<Sequence DisplayName="SendGrid call failed" sap2010:WorkflowViewState.IdRef="Sequence_9">
<ui:Comment Text="TODO(Studio): out_Success = False ; map status as above ; rethrow on 401 or 403" sap2010:WorkflowViewState.IdRef="Comment_8" />
</Sequence>
</ActivityAction>
</Catch>
</TryCatch.Catches>
</TryCatch>
<Sequence DisplayName="4. Log" sap2010:WorkflowViewState.IdRef="Sequence_13">
<ui:LogMessage DisplayName="Log masked result" Level="Info" Message='["Email to " &amp; in_To.Substring(0, 2) &amp; "****" &amp; in_To.Substring(in_To.IndexOf("@")) &amp; " success=" &amp; out_Success.ToString()]' sap2010:WorkflowViewState.IdRef="LogMessage_12" />
</Sequence>
</Sequence>
