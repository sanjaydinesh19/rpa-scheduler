<Activity mc:Ignorable="sap sap2010" x:Class="SendEmail"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_To" Type="InArgument(x:String)" />
    <x:Property Name="in_Subject" Type="InArgument(x:String)" />
    <x:Property Name="in_HtmlBody" Type="InArgument(x:String)" />
    <x:Property Name="in_ApiKey" Type="InArgument(s:Security.SecureString)" />
    <x:Property Name="in_FromEmail" Type="InArgument(x:String)" />
    <x:Property Name="in_DryRun" Type="InArgument(x:Boolean)" />
    <x:Property Name="out_Success" Type="OutArgument(x:Boolean)" />
    <x:Property Name="out_MessageId" Type="OutArgument(x:String)" />
    <x:Property Name="out_ErrorCode" Type="OutArgument(x:String)" />
    <x:Property Name="out_Retryable" Type="OutArgument(x:Boolean)" />
  </x:Members>
  <sap2010:ExpressionActivityEditor.ExpressionActivityEditor>VisualBasic</sap2010:ExpressionActivityEditor.ExpressionActivityEditor>
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="8">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Net.Http</x:String>
      <x:String>System.Text.RegularExpressions</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>Newtonsoft.Json.Linq</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference" Capacity="8">
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Net.Http</AssemblyReference>
      <AssemblyReference>System.Text.RegularExpressions</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>Newtonsoft.Json</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>

  <Sequence DisplayName="Send Email via SendGrid" sap2010:WorkflowViewState.IdRef="Seq_Root">
    <sap2010:Annotation.AnnotationText>shared/SendEmail.xaml — SendGrid wrapper via InvokeCode + System.Net.Http.

Dry run: whole pipeline runs, provider = DRYRUN.
Live:    POST /v3/mail/send with Bearer auth. 202 = success (empty body).
         401/403 = system exception (bad key or unverified Single Sender).</sap2010:Annotation.AnnotationText>

    <ui:InvokeCode DisplayName="SendGrid send"
      sap2010:WorkflowViewState.IdRef="InvokeCode_SG"
      Language="VBNet"
      Code="out_Success = False
out_MessageId = &quot;&quot;
out_ErrorCode = &quot;&quot;
out_Retryable = False

' Guard: email shape
If String.IsNullOrWhiteSpace(in_To) OrElse Not System.Text.RegularExpressions.Regex.IsMatch(in_To, &quot;^[^@\s]+@[^@\s]+\.[^@\s]+$&quot;) Then
    out_ErrorCode = &quot;INVALID_CONTACT&quot;
    Return
End If

' Dry run
If in_DryRun Then
    out_MessageId = &quot;DRYRUN-&quot; &amp; Guid.NewGuid().ToString(&quot;N&quot;).Substring(0, 12)
    out_Success = True
    Return
End If

Try
    Dim keyPlain As String = New System.Net.NetworkCredential(String.Empty, in_ApiKey).Password
    Dim payload As New Newtonsoft.Json.Linq.JObject()
    payload(&quot;personalizations&quot;) = New Newtonsoft.Json.Linq.JArray(New Newtonsoft.Json.Linq.JObject(New Newtonsoft.Json.Linq.JProperty(&quot;to&quot;, New Newtonsoft.Json.Linq.JArray(New Newtonsoft.Json.Linq.JObject(New Newtonsoft.Json.Linq.JProperty(&quot;email&quot;, in_To))))))
    payload(&quot;from&quot;) = New Newtonsoft.Json.Linq.JObject(New Newtonsoft.Json.Linq.JProperty(&quot;email&quot;, in_FromEmail))
    payload(&quot;subject&quot;) = in_Subject
    payload(&quot;content&quot;) = New Newtonsoft.Json.Linq.JArray(New Newtonsoft.Json.Linq.JObject(New Newtonsoft.Json.Linq.JProperty(&quot;type&quot;, &quot;text/html&quot;), New Newtonsoft.Json.Linq.JProperty(&quot;value&quot;, in_HtmlBody)))
    Dim jsonBody As String = payload.ToString()

    Dim client As New System.Net.Http.HttpClient()
    client.Timeout = TimeSpan.FromSeconds(30)
    Dim req As New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, &quot;https://api.sendgrid.com/v3/mail/send&quot;)
    req.Headers.TryAddWithoutValidation(&quot;Authorization&quot;, &quot;Bearer &quot; &amp; keyPlain)
    req.Headers.TryAddWithoutValidation(&quot;Accept&quot;, &quot;application/json&quot;)
    req.Content = New System.Net.Http.StringContent(jsonBody, System.Text.Encoding.UTF8, &quot;application/json&quot;)

    Dim resp As System.Net.Http.HttpResponseMessage = client.SendAsync(req).GetAwaiter().GetResult()
    Dim status As Integer = CInt(resp.StatusCode)
    Dim body As String = resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()
    client.Dispose()

    If status = 202 Then
        out_MessageId = &quot;SG-&quot; &amp; Guid.NewGuid().ToString(&quot;N&quot;).Substring(0, 12)
        out_Success = True
    ElseIf status = 401 OrElse status = 403 Then
        Throw New System.InvalidOperationException(&quot;SendGrid returned &quot; &amp; status.ToString() &amp; &quot; — SendGrid_ApiKey or Single Sender not set up&quot;)
    Else
        out_ErrorCode = If(status = 400, &quot;INVALID_CONTACT&quot;, &quot;SENDGRID_HTTP_&quot; &amp; status.ToString())
        out_Retryable = (status = 429) OrElse (status &gt;= 500)
    End If
Catch iex As System.InvalidOperationException
    Throw
Catch ex As Exception
    out_ErrorCode = &quot;NETWORK_TIMEOUT&quot;
    out_Retryable = True
End Try">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="in_To">[in_To]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_Subject">[in_Subject]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_HtmlBody">[in_HtmlBody]</InArgument>
        <InArgument x:TypeArguments="s:Security.SecureString" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_FromEmail">[in_FromEmail]</InArgument>
        <InArgument x:TypeArguments="x:Boolean" x:Key="in_DryRun">[in_DryRun]</InArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[out_Success]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_MessageId">[out_MessageId]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[out_ErrorCode]</OutArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Retryable">[out_Retryable]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>

    <ui:LogMessage DisplayName="Log masked result" Level="Info"
      Message="[&quot;EMAIL to &quot; &amp; If(in_To.Contains(&quot;@&quot;), in_To.Substring(0, Math.Min(2, in_To.IndexOf(&quot;@&quot;c))) &amp; &quot;****&quot; &amp; in_To.Substring(in_To.IndexOf(&quot;@&quot;c)), in_To) &amp; &quot; success=&quot; &amp; out_Success.ToString() &amp; &quot; err=&quot; &amp; out_ErrorCode]"
      sap2010:WorkflowViewState.IdRef="Log_Done" />
  </Sequence>
</Activity>
